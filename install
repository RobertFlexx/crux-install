VERSION="3.8-easy-3.0.1"
CRUX_RELEASE="3.8"
TARGET="/mnt"
MEDIA="/media/crux"
LOGFILE="/tmp/crux-installer.log"
PATH="/usr/bin:/usr/sbin:/bin:/sbin"
LC_ALL=C
export PATH LC_ALL
umask 022

# Runtime state.
rdisk=""
rdiskr=""
boot=""
sw=""
home=""
root_fs="ext4"
home_fs=""
hostn="crux"
tzone="UTC"
locale_name="C.UTF-8"
keymap="us"
nic_conf=""
ip_mode="none"
ip_addr=""
subnet_mask="24"
gateway=""
ns1=""
ns2=""
user_name="user"
desktop_choice="none"
desktop_label=""
desktop_session_cmd=""
use_xdm="no"
use_networkmanager="no"
install_flatpak="no"
install_pipewire="no"
enable_compat32="no"
update_ports_now="no"
services_list=""
bindings_mounted="no"
keep_mounts="no"
install_mode="fresh"

# Guided-install state.
FS_RESULT=""
SELECTED_BLOCK=""
selected_gpu="auto"
detected_gpu="generic"
display_manager="xdm"
enable_alan_sddm="no"
install_bluetooth="no"
install_printing="no"
install_firmware="yes"
install_discover="yes"
install_gaming32="no"
base_install_method="automatic"
advanced_repositories="no"
nvidia_proprietary_modules="0"
enable_sshd="ask"

say() {
    printf '%s\n' "$*"
}

info() {
    printf '  -> %s\n' "$*"
    printf '%s INFO: %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf unknown)" "$*" >> "$LOGFILE"
}

warn() {
    printf 'warning: %s\n' "$*" >&2
    printf '%s WARN: %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf unknown)" "$*" >> "$LOGFILE"
}

die() {
    printf 'error: %s\n' "$*" >&2
    printf '%s ERROR: %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf unknown)" "$*" >> "$LOGFILE"
    exit 1
}

pause() {
    printf '\nPress Enter to continue... ' >&2
    IFS= read -r _pause_answer || true
}

ask() {
    prompt=$1
    default=$2
    printf '%s [%s]: ' "$prompt" "$default" >&2
    IFS= read -r answer || answer=""
    if [ -n "$answer" ]; then
        printf '%s' "$answer"
    else
        printf '%s' "$default"
    fi
}

ask_optional() {
    prompt=$1
    default=$2
    if [ -n "$default" ]; then
        printf '%s [%s]: ' "$prompt" "$default" >&2
    else
        printf '%s [leave blank for none]: ' "$prompt" >&2
    fi
    IFS= read -r answer || answer=""
    if [ -n "$answer" ]; then
        printf '%s' "$answer"
    else
        printf '%s' "$default"
    fi
}

confirm() {
    prompt=$1
    default=$2
    case "$default" in
        y|Y|yes|YES) suffix="Y/n" ;;
        *) suffix="y/N" ;;
    esac
    while :; do
        printf '%s [%s]: ' "$prompt" "$suffix" >&2
        IFS= read -r answer || answer=""
        [ -n "$answer" ] || answer=$default
        case "$answer" in
            y|Y|yes|YES|Yes) return 0 ;;
            n|N|no|NO|No) return 1 ;;
            *) warn "please answer yes or no" ;;
        esac
    done
}

choose_number() {
    prompt=$1
    default=$2
    min=$3
    max=$4
    while :; do
        value=$(ask "$prompt" "$default")
        case "$value" in
            ''|*[!0-9]*) warn "enter a number from $min to $max" ;;
            *)
                if [ "$value" -ge "$min" ] 2>/dev/null && [ "$value" -le "$max" ] 2>/dev/null; then
                    printf '%s' "$value"
                    return 0
                fi
                warn "enter a number from $min to $max"
                ;;
        esac
    done
}


choose_from_file() {
    list_file=$1
    prompt=$2
    default=$3
    [ -s "$list_file" ] || return 1
    count=$(wc -l < "$list_file" | awk '{print $1}')
    valid_uint "$count" || return 1
    [ "$count" -gt 0 ] || return 1
    choice=$(choose_number "$prompt" "$default" 1 "$count")
    SELECTED_LINE=$(sed -n "${choice}p" "$list_file")
    [ -n "$SELECTED_LINE" ]
}

is_partition_mounted() {
    dev=$1
    if have lsblk; then
        lsblk -nr -o MOUNTPOINTS "$dev" 2>/dev/null | grep -q '[^[:space:]]'
    else
        grep -q "^${dev}[[:space:]]" /proc/mounts 2>/dev/null
    fi
}

partition_is_swap_active() {
    dev=$1
    have swapon || return 1
    swapon --noheadings --show=NAME 2>/dev/null | grep -Fqx "$dev"
}

block_summary() {
    dev=$1
    size=$(lsblk -dn -o SIZE "$dev" 2>/dev/null | awk '{$1=$1;print}')
    fstype=$(blk_value TYPE "$dev")
    label=$(blk_value LABEL "$dev")
    partlabel=$(lsblk -dn -o PARTLABEL "$dev" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    mounts=$(lsblk -nr -o MOUNTPOINTS "$dev" 2>/dev/null | paste -sd ',' - | sed 's/^[, ]*//;s/[, ]*$//')
    printf '%s  size=%s  fs=%s  label=%s  partlabel=%s%s\n' \
        "$dev" "${size:-?}" "${fstype:-none}" "${label:-none}" "${partlabel:-none}" \
        "${mounts:+  mounted=$mounts}"
}

have() {
    command -v "$1" >/dev/null 2>&1
}

require_commands() {
    missing=""
    for cmd in "$@"; do
        if ! have "$cmd"; then
            missing="$missing $cmd"
        fi
    done
    [ -z "$missing" ] || die "required command(s) missing:$missing"
}

is_mounted() {
    point=$1
    if have mountpoint; then
        mountpoint -q "$point" 2>/dev/null
    else
        awk -v p="$point" '$2 == p {found=1} END {exit !found}' /proc/mounts 2>/dev/null
    fi
}

is_uefi() {
    [ -d /sys/firmware/efi/efivars ]
}

is_block() {
    [ -b "$1" ]
}

is_whole_disk() {
    dev=$1
    [ -b "$dev" ] || return 1
    if have lsblk; then
        [ "$(lsblk -dn -o TYPE "$dev" 2>/dev/null)" = "disk" ]
    else
        return 0
    fi
}

valid_hostname() {
    value=$1
    case "$value" in
        ''|.*|*..*|*-|_*|*[!A-Za-z0-9.-]*) return 1 ;;
    esac
    [ "${#value}" -le 253 ] || return 1
    oldifs=$IFS
    IFS=.
    set -- $value
    IFS=$oldifs
    for label in "$@"; do
        [ -n "$label" ] || return 1
        [ "${#label}" -le 63 ] || return 1
        case "$label" in -*|*-) return 1 ;; esac
    done
    return 0
}

valid_username() {
    value=$1
    case "$value" in
        ''|*[!a-z0-9_-]*|[0-9-]*|root) return 1 ;;
    esac
    [ "${#value}" -le 31 ]
}

valid_repo_name() {
    case "$1" in
        ''|*[!A-Za-z0-9_.-]*) return 1 ;;
        *) return 0 ;;
    esac
}

valid_package_name() {
    case "$1" in
        ''|*[!A-Za-z0-9+_.-]*) return 1 ;;
        *) return 0 ;;
    esac
}

valid_uint() {
    case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

valid_ipv4() {
    value=$1
    oldifs=$IFS
    IFS=.
    set -- $value
    IFS=$oldifs
    [ "$#" -eq 4 ] || return 1
    for octet in "$@"; do
        valid_uint "$octet" || return 1
        [ "$octet" -ge 0 ] 2>/dev/null && [ "$octet" -le 255 ] 2>/dev/null || return 1
    done
    return 0
}

validate_block_or_die() {
    label=$1
    dev=$2
    is_block "$dev" || die "$label '$dev' is not a block device"
}

partdev() {
    disk_name=${rdisk#/dev/}
    number=$1
    case "$disk_name" in
        *[0-9]) printf '/dev/%sp%s' "$disk_name" "$number" ;;
        *) printf '/dev/%s%s' "$disk_name" "$number" ;;
    esac
}

blk_value() {
    field=$1
    dev=$2
    blkid -s "$field" -o value "$dev" 2>/dev/null || true
}

fsck_pass() {
    case "$1" in
        ext2|ext3|ext4) printf '%s' "$2" ;;
        *) printf '0' ;;
    esac
}

add_service() {
    svc=$1
    case " $services_list " in
        *" $svc "*) ;;
        *) services_list="${services_list:+$services_list }$svc" ;;
    esac
}

service_exists() {
    [ -x "$TARGET/etc/rc.d/$1" ]
}

show_banner() {
    cat <<EOF

CRUX $CRUX_RELEASE Easy Installer $VERSION
===========================================
This installer can erase a whole disk or reuse partitions, installs the CRUX
base system, builds a bootable kernel, configures GRUB, and can prepare a full
KDE Plasma desktop with networking, audio, Flatpak/Flathub, and GPU drivers.

IMPORTANT: formatting or automatic partitioning destroys data. Every destructive
step has a summary and a typed confirmation. Log: $LOGFILE
EOF
}

show_help() {
    cat <<EOF
Usage: ${0##*/} [OPTION]

  --install       start a guided fresh installation
  --resume        continue an interrupted installation already placed on disk
  --upgrade       mount an installed CRUX system and run the upgrade path
  --self-test     run non-destructive parser and mapping tests
  --shell         exit immediately to the installation shell
  --version       print version information
  --help          show this help

Without an option, an interactive menu is shown.
EOF
}

preflight() {
    [ "$(id -u 2>/dev/null)" = "0" ] || die "run this installer as root"
    : > "$LOGFILE" || die "cannot create $LOGFILE"
    require_commands awk sed grep find sort mount umount blkid

    if [ ! -d "$MEDIA" ]; then
        warn "CRUX installation media was not found at $MEDIA"
        warn "the base package and kernel stages will fail unless the ISO is mounted there"
    fi

    if [ ! -t 0 ]; then
        warn "standard input is not a terminal; interactive prompts may not behave as expected"
    fi
}

main_menu() {
    say ""
    say "  1) Install CRUX 3.8"
    say "  2) Resume an interrupted installation"
    say "  3) Upgrade an existing CRUX installation"
    say "  4) Exit to shell"
    choice=$(choose_number "Choose an action" "1" 1 4)
    case "$choice" in
        1) fresh_install ;;
        2) resume_install ;;
        3) upgrade_install ;;
        4) exit 0 ;;
    esac
}

network_interfaces() {
    if have ip; then
        ip -o link show 2>/dev/null | awk -F': ' '$2 != "lo" {sub(/@.*/, "", $2); print $2}'
    elif have ifconfig; then
        ifconfig -a 2>/dev/null | awk -F: '/^[A-Za-z0-9]/ {print $1}' | grep -v '^lo$'
    fi
}

zone_table() {
    if [ -r /usr/share/zoneinfo/zone1970.tab ]; then
        printf '%s\n' /usr/share/zoneinfo/zone1970.tab
    elif [ -r /usr/share/zoneinfo/zone.tab ]; then
        printf '%s\n' /usr/share/zoneinfo/zone.tab
    else
        return 1
    fi
}

validate_timezone() {
    zone=$1
    [ "$zone" = "UTC" ] || [ -e "/usr/share/zoneinfo/$zone" ]
}

browse_timezones() {
    table=$(zone_table) || return 1
    regions=$(mktemp /tmp/crux-regions.XXXXXX) || return 1
    zones=$(mktemp /tmp/crux-zones.XXXXXX) || { rm -f "$regions"; return 1; }
    awk -F '\t' '!/^#/ && NF >= 3 {split($3,a,"/"); print a[1]}' "$table" | sort -u > "$regions"
    say ""
    nl -ba -w2 -s') ' "$regions"
    choose_from_file "$regions" "Timezone region" "1" || { rm -f "$regions" "$zones"; return 1; }
    region=$SELECTED_LINE
    awk -F '\t' -v r="$region/" '!/^#/ && NF >= 3 && index($3,r)==1 {print $3}' "$table" | sort -u > "$zones"
    [ -s "$zones" ] || { rm -f "$regions" "$zones"; return 1; }
    say ""
    nl -ba -w3 -s') ' "$zones"
    choose_from_file "$zones" "Timezone" "1" || { rm -f "$regions" "$zones"; return 1; }
    tzone=$SELECTED_LINE
    rm -f "$regions" "$zones"
    return 0
}

choose_timezone() {
    while :; do
        say ""
        say "Timezone"
        say "--------"
        say "  1) UTC"
        say "  2) America/Los_Angeles (Pacific)"
        say "  3) America/Denver      (Mountain)"
        say "  4) America/Chicago     (Central)"
        say "  5) America/New_York    (Eastern)"
        say "  6) Browse every installed timezone"
        say "  7) Type an Area/City name"
        tz_choice=$(choose_number "Choose timezone" "2" 1 7)
        case "$tz_choice" in
            1) tzone=UTC ;;
            2) tzone=America/Los_Angeles ;;
            3) tzone=America/Denver ;;
            4) tzone=America/Chicago ;;
            5) tzone=America/New_York ;;
            6) browse_timezones || warn "could not read the timezone database" ;;
            7) tzone=$(ask "Timezone (Area/City)" "UTC") ;;
        esac
        if validate_timezone "$tzone"; then
            info "selected timezone $tzone"
            return 0
        fi
        warn "timezone '$tzone' does not exist under /usr/share/zoneinfo"
    done
}

configure_identity() {
    while :; do
        hostn=$(ask "System hostname" "crux")
        valid_hostname "$hostn" && break
        warn "use letters, digits, dots, and hyphens; labels cannot begin or end with a hyphen"
    done

    choose_timezone

    keymap=$(ask "Console keymap" "us")
    locale_name=$(ask "System locale" "C.UTF-8")
}

configure_install_network() {
    say ""
    say "Network setup"
    say "-------------"
    interfaces=$(network_interfaces | paste -sd ' ' -)
    if [ -n "$interfaces" ]; then
        say "Detected interfaces: $interfaces"
        first_interface=$(printf '%s\n' "$interfaces" | awk '{print $1}')
    else
        say "No non-loopback interfaces were detected."
        first_interface="none"
    fi

    nic_conf=$(ask_optional "Interface to configure, or 'none'" "$first_interface")
    case "$nic_conf" in
        none|NONE|None|'')
            nic_conf=""
            ip_mode="none"
            return 0
            ;;
    esac

    case " $interfaces " in
        *" $nic_conf "*) ;;
        *)
            if ! confirm "'$nic_conf' was not detected. Use it anyway?" "n"; then
                nic_conf=""
                ip_mode="none"
                return 0
            fi
            ;;
    esac

    say ""
    say "  1) DHCP (recommended)"
    say "  2) Static IPv4"
    say "  3) Do not configure it now"
    net_choice=$(choose_number "Network mode" "1" 1 3)
    case "$net_choice" in
        1)
            ip_mode="dhcp"
            ;;
        2)
            ip_mode="static"
            while :; do
                ip_addr=$(ask "IPv4 address" "192.168.1.100")
                valid_ipv4 "$ip_addr" && break
                warn "invalid IPv4 address"
            done
            while :; do
                subnet_mask=$(ask "CIDR prefix length" "24")
                valid_uint "$subnet_mask" && [ "$subnet_mask" -ge 1 ] && [ "$subnet_mask" -le 32 ] && break
                warn "CIDR prefix must be from 1 to 32"
            done
            guessed_gateway=$(printf '%s' "$ip_addr" | sed 's/\.[0-9][0-9]*$/.1/')
            while :; do
                gateway=$(ask_optional "Default gateway" "$guessed_gateway")
                [ -z "$gateway" ] || valid_ipv4 "$gateway" && break
                warn "invalid gateway address"
            done
            while :; do
                ns1=$(ask_optional "Primary DNS server" "1.1.1.1")
                [ -z "$ns1" ] || valid_ipv4 "$ns1" && break
                warn "invalid DNS address"
            done
            while :; do
                ns2=$(ask_optional "Secondary DNS server" "9.9.9.9")
                [ -z "$ns2" ] || valid_ipv4 "$ns2" && break
                warn "invalid DNS address"
            done
            ;;
        3)
            ip_mode="none"
            nic_conf=""
            ;;
    esac
}

list_disks() {
    disk_file=$1
    : > "$disk_file"
    say ""
    say "Available install disks"
    say "-----------------------"
    if have lsblk; then
        lsblk -dn -p -o NAME,TYPE,RO 2>/dev/null | awk '$2 == "disk" && $3 == 0 {print $1}' > "$disk_file"
    else
        fdisk -l 2>/dev/null | awk '/^Disk \/dev\// {sub(":", "", $2); print $2}' > "$disk_file"
    fi
    n=1
    while IFS= read -r dev; do
        [ -n "$dev" ] || continue
        size=$(lsblk -dn -o SIZE "$dev" 2>/dev/null | awk '{$1=$1;print}')
        model=$(lsblk -dn -o MODEL "$dev" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        tran=$(lsblk -dn -o TRAN "$dev" 2>/dev/null | awk '{$1=$1;print}')
        printf '  %d) %-16s %-9s %-8s %s\n' "$n" "$dev" "${size:-?}" "${tran:-?}" "${model:-unknown}"
        n=$((n + 1))
    done < "$disk_file"
}

first_disk() {
    tmp=$(mktemp /tmp/crux-disks.XXXXXX) || return 1
    list_disks "$tmp" >/dev/null
    sed -n '1p' "$tmp"
    rm -f "$tmp"
}

select_disk() {
    require_commands sfdisk wipefs lsblk
    while :; do
        disks=$(mktemp /tmp/crux-disks.XXXXXX) || die "cannot create disk list"
        list_disks "$disks"
        [ -s "$disks" ] || { rm -f "$disks"; die "no writable whole disks were detected"; }
        say ""
        say "Type '?' at the prompt only if you need the full lsblk view."
        count=$(wc -l < "$disks" | awk '{print $1}')
        disk_choice=$(ask "Disk number, or ?" "1")
        if [ "$disk_choice" = "?" ]; then
            lsblk -o NAME,SIZE,FSTYPE,FSVER,LABEL,PARTLABEL,PARTTYPE,TYPE,MOUNTPOINTS,MODEL 2>/dev/null || true
            rm -f "$disks"
            pause
            continue
        fi
        case "$disk_choice" in ''|*[!0-9]*) warn "enter a listed disk number"; rm -f "$disks"; continue ;; esac
        [ "$disk_choice" -ge 1 ] 2>/dev/null && [ "$disk_choice" -le "$count" ] 2>/dev/null || {
            warn "enter a number from 1 to $count"; rm -f "$disks"; continue;
        }
        rdisk=$(sed -n "${disk_choice}p" "$disks")
        rm -f "$disks"
        is_whole_disk "$rdisk" || { warn "'$rdisk' is not a whole-disk block device"; continue; }
        say ""
        say "Selected disk:"
        lsblk -o NAME,SIZE,FSTYPE,LABEL,PARTLABEL,TYPE,MOUNTPOINTS,MODEL "$rdisk" 2>/dev/null || true
        confirm "Use $rdisk as the installation disk?" "y" && break
    done
}

show_disk_mounts() {
    if have lsblk; then
        lsblk -n -p -o NAME,TYPE,FSTYPE,SIZE,MOUNTPOINTS "$rdisk" 2>/dev/null || true
    fi
}

disk_has_mounts() {
    if have lsblk; then
        lsblk -nr -o MOUNTPOINTS "$rdisk" 2>/dev/null | grep -q '[^[:space:]]'
    else
        grep -q "^${rdisk}" /proc/mounts 2>/dev/null
    fi
}

disk_has_active_swap() {
    have swapon || return 1
    have lsblk || return 1
    disk_nodes=$(lsblk -nr -p -o NAME "$rdisk" 2>/dev/null)
    active_swaps=$(swapon --noheadings --show=NAME 2>/dev/null || true)
    [ -n "$active_swaps" ] || return 1
    for swap_device in $active_swaps; do
        printf '%s\n' "$disk_nodes" | grep -Fqx "$swap_device" && return 0
    done
    return 1
}

wait_for_block() {
    dev=$1
    tries=0
    while [ "$tries" -lt 20 ]; do
        [ -b "$dev" ] && return 0
        sleep 1
        tries=$((tries + 1))
    done
    return 1
}

filesystem_menu() {
    purpose=$1
    default=$2
    while :; do
        say ""
        say "Filesystem for $purpose"
        say "--------------------------"
        say "  1) ext4   - recommended; simple, mature, and easy to repair"
        say "  2) btrfs  - checksums and snapshots"
        say "  3) xfs    - strong choice for large files and throughput"
        say "  4) jfs    - advanced/legacy choice"
        say "  5) ext3   - legacy compatibility"
        say "  6) ext2   - no journal; generally not recommended"
        case "$default" in btrfs) d=2 ;; xfs) d=3 ;; jfs) d=4 ;; ext3) d=5 ;; ext2) d=6 ;; *) d=1 ;; esac
        fchoice=$(choose_number "Choose filesystem" "$d" 1 6)
        case "$fchoice" in
            1) FS_RESULT=ext4 ;;
            2) FS_RESULT=btrfs ;;
            3) FS_RESULT=xfs ;;
            4) FS_RESULT=jfs ;;
            5) FS_RESULT=ext3 ;;
            6) FS_RESULT=ext2 ;;
        esac
        case "$FS_RESULT" in
            btrfs) mkfs_cmd=mkfs.btrfs ;;
            xfs) mkfs_cmd=mkfs.xfs ;;
            jfs) mkfs_cmd=mkfs.jfs ;;
            *) mkfs_cmd="mkfs.$FS_RESULT" ;;
        esac
        if have "$mkfs_cmd"; then
            return 0
        fi
        warn "$mkfs_cmd is unavailable on this installer media; choose another filesystem"
    done
}

format_filesystem() {
    fs_type=$1
    target_dev=$2
    label=$3
    validate_block_or_die "$label" "$target_dev"
    info "formatting $target_dev as $fs_type"
    case "$fs_type" in
        btrfs) mkfs.btrfs -f -L "$label" "$target_dev" || die "failed to format $target_dev as btrfs" ;;
        xfs) mkfs.xfs -f -L "$label" "$target_dev" || die "failed to format $target_dev as xfs" ;;
        jfs) mkfs.jfs -q -f -L "$label" "$target_dev" || die "failed to format $target_dev as jfs" ;;
        ext2|ext3|ext4) "mkfs.$fs_type" -F -L "$label" "$target_dev" || die "failed to format $target_dev as $fs_type" ;;
        *) die "unsupported filesystem '$fs_type'" ;;
    esac
}

prepare_target_mountpoint() {
    mkdir -p "$TARGET" || die "cannot create $TARGET"
    if is_mounted "$TARGET"; then
        die "$TARGET is already mounted; unmount it before starting a fresh installation"
    fi
}

mount_root_target() {
    prepare_target_mountpoint
    mount "$rdiskr" "$TARGET" || die "failed to mount root partition $rdiskr"
}

partition_menu() {
    say ""
    say "Partitioning"
    say "------------"
    say "  1) Automatic: erase and repartition the entire selected disk"
    say "  2) Guided reuse: choose existing partitions from numbered lists"
    say "  3) Edit with cfdisk, then choose partitions from numbered lists"
    pchoice=$(choose_number "Partitioning method" "2" 1 3)
    case "$pchoice" in
        1) automatic_partition ;;
        2) manual_partition "no" ;;
        3) manual_partition "yes" ;;
    esac
}

run_sfdisk_layout() {
    layout_file=$1
    if sfdisk --help 2>&1 | grep -q -- '--wipe-partitions'; then
        sfdisk --wipe always --wipe-partitions always "$rdisk" < "$layout_file"
    else
        sfdisk --wipe always "$rdisk" < "$layout_file"
    fi
}

automatic_partition() {
    say ""
    warn "AUTOMATIC PARTITIONING WILL ERASE EVERY PARTITION ON $rdisk"
    show_disk_mounts
    if disk_has_mounts; then
        die "one or more partitions on $rdisk are mounted; unmount them before continuing"
    fi
    if disk_has_active_swap; then
        die "a swap partition on $rdisk is active; disable it with swapoff before continuing"
    fi

    filesystem_menu "the root partition" "ext4"
    root_fs=$FS_RESULT
    while :; do
        swap_mib=$(ask "Swap size in MiB (0 disables swap)" "2048")
        valid_uint "$swap_mib" && break
        warn "swap size must be a non-negative whole number"
    done

    if is_uefi; then
        while :; do
            efi_mib=$(ask "EFI System Partition size in MiB" "1024")
            valid_uint "$efi_mib" && [ "$efi_mib" -ge 260 ] && break
            warn "use at least 260 MiB for the EFI System Partition"
        done
        boot_mode="UEFI"
    else
        efi_mib=0
        boot_mode="legacy BIOS"
    fi

    say ""
    say "Destructive operation summary"
    say "-----------------------------"
    say "Disk:             $rdisk"
    say "Boot mode:        $boot_mode"
    [ "$efi_mib" -gt 0 ] && say "EFI partition:    ${efi_mib} MiB, FAT32"
    ! is_uefi && say "BIOS boot area:   2 MiB"
    [ "$swap_mib" -gt 0 ] && say "Swap partition:   ${swap_mib} MiB"
    [ "$swap_mib" -eq 0 ] && say "Swap partition:   disabled"
    say "Root filesystem:  $root_fs"
    say "Root partition:   remaining disk space"
    say ""
    typed=$(ask "Type the full disk path to confirm erasure" "CANCEL")
    [ "$typed" = "$rdisk" ] || die "disk erasure was not confirmed"

    layout=$(mktemp /tmp/crux-layout.XXXXXX) || die "cannot create temporary partition layout"
    if is_uefi; then
        cat > "$layout" <<EOF
label: gpt
size=${efi_mib}MiB, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, name="EFI System"
EOF
        if [ "$swap_mib" -gt 0 ]; then
            cat >> "$layout" <<EOF
size=${swap_mib}MiB, type=0657FD6D-A4AB-43C4-84E5-0933C84B4F4F, name="Linux swap"
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="CRUX root"
EOF
        else
            cat >> "$layout" <<EOF
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="CRUX root"
EOF
        fi
    else
        cat > "$layout" <<EOF
label: gpt
size=2MiB, type=21686148-6449-6E6F-744E-656564454649, name="BIOS boot"
EOF
        if [ "$swap_mib" -gt 0 ]; then
            cat >> "$layout" <<EOF
size=${swap_mib}MiB, type=0657FD6D-A4AB-43C4-84E5-0933C84B4F4F, name="Linux swap"
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="CRUX root"
EOF
        else
            cat >> "$layout" <<EOF
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="CRUX root"
EOF
        fi
    fi

    info "wiping old signatures from $rdisk"
    wipefs -a "$rdisk" || die "wipefs failed on $rdisk"
    info "creating GPT partition table on $rdisk"
    run_sfdisk_layout "$layout" || {
        rm -f "$layout"
        die "sfdisk failed while partitioning $rdisk"
    }
    rm -f "$layout"
    have partprobe && partprobe "$rdisk" >/dev/null 2>&1 || true
    have udevadm && udevadm settle >/dev/null 2>&1 || true

    if is_uefi; then
        boot=$(partdev 1)
        if [ "$swap_mib" -gt 0 ]; then
            sw=$(partdev 2)
            rdiskr=$(partdev 3)
        else
            sw=""
            rdiskr=$(partdev 2)
        fi
    else
        boot=""
        if [ "$swap_mib" -gt 0 ]; then
            sw=$(partdev 2)
            rdiskr=$(partdev 3)
        else
            sw=""
            rdiskr=$(partdev 2)
        fi
    fi

    wait_for_block "$rdiskr" || die "root partition device $rdiskr did not appear"
    if is_uefi; then
        wait_for_block "$boot" || die "EFI partition device $boot did not appear"
        have mkfs.vfat || die "mkfs.vfat is required for UEFI installation"
        mkfs.vfat -F 32 -n EFI "$boot" || die "failed to format EFI partition"
    fi
    if [ -n "$sw" ]; then
        wait_for_block "$sw" || die "swap partition device $sw did not appear"
        mkswap -L swap "$sw" || die "failed to create swap"
        swapon "$sw" || warn "could not enable swap during installation"
    fi

    format_filesystem "$root_fs" "$rdiskr" CRUX_ROOT
    mount_root_target
    if [ -n "$boot" ]; then
        mkdir -p "$TARGET/boot"
        mount "$boot" "$TARGET/boot" || die "failed to mount EFI partition at $TARGET/boot"
    fi
    home=""
    home_fs=""
}

partition_candidates() {
    lsblk -ln -p -o NAME,TYPE "$rdisk" 2>/dev/null | awk '$2 == "part" {print $1}'
}

show_partition_choices() {
    file=$1
    : > "$file"
    partition_candidates > "$file"
    say ""
    say "Partitions on $rdisk"
    say "--------------------"
    n=1
    while IFS= read -r dev; do
        printf '  %d) ' "$n"
        block_summary "$dev"
        n=$((n + 1))
    done < "$file"
}

select_existing_partition() {
    purpose=$1
    allow_none=$2
    parts=$(mktemp /tmp/crux-parts.XXXXXX) || die "cannot create partition list"
    show_partition_choices "$parts"
    [ -s "$parts" ] || { rm -f "$parts"; die "no partitions exist on $rdisk"; }
    count=$(wc -l < "$parts" | awk '{print $1}')
    if [ "$allow_none" = yes ]; then
        say "  0) none"
        choice=$(ask "$purpose partition number" "0")
        case "$choice" in 0|'') SELECTED_BLOCK=""; rm -f "$parts"; return 0 ;; esac
    else
        choice=$(ask "$purpose partition number" "1")
    fi
    case "$choice" in ''|*[!0-9]*) rm -f "$parts"; warn "enter a partition number"; return 1 ;; esac
    [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "$count" ] 2>/dev/null || {
        rm -f "$parts"; warn "partition number must be from 1 to $count"; return 1;
    }
    SELECTED_BLOCK=$(sed -n "${choice}p" "$parts")
    rm -f "$parts"
    validate_block_or_die "$purpose partition" "$SELECTED_BLOCK"
}

find_esp_candidate() {
    esp_guid=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
    for dev in $(partition_candidates); do
        parttype=$(lsblk -dn -o PARTTYPE "$dev" 2>/dev/null | tr 'A-F' 'a-f' | awk '{$1=$1;print}')
        fstype=$(blk_value TYPE "$dev")
        if [ "$parttype" = "$esp_guid" ] || [ "$fstype" = "vfat" ]; then
            printf '%s\n' "$dev"
            return 0
        fi
    done
    return 1
}

manual_partition() {
    open_editor=${1:-no}
    if [ "$open_editor" = yes ]; then
        have cfdisk || die "cfdisk is required for partition-table editing"
        if disk_has_mounts; then
            warn "some partitions on $rdisk are mounted"
            show_disk_mounts
            confirm "Open cfdisk anyway?" "n" || die "partition editing cancelled"
        fi
        info "starting cfdisk for $rdisk"
        cfdisk "$rdisk" || die "cfdisk exited with an error"
        have partprobe && partprobe "$rdisk" >/dev/null 2>&1 || true
        have udevadm && udevadm settle >/dev/null 2>&1 || true
    fi

    while :; do
        select_existing_partition "Root" no || continue
        rdiskr=$SELECTED_BLOCK
        if is_partition_mounted "$rdiskr"; then
            warn "$rdiskr is mounted; unmount it before using it as root"
            continue
        fi
        if partition_is_swap_active "$rdiskr"; then
            warn "$rdiskr is active swap; run swapoff first"
            continue
        fi
        break
    done

    detected_root_fs=$(blk_value TYPE "$rdiskr")
    say ""
    block_summary "$rdiskr"
    if confirm "FORMAT $rdiskr for the new root filesystem?" "y"; then
        filesystem_menu "the root partition" "${detected_root_fs:-ext4}"
        root_fs=$FS_RESULT
        say ""
        warn "Formatting $rdiskr as $root_fs permanently erases that partition."
        typed=$(ask "Type the full partition path to confirm" "CANCEL")
        [ "$typed" = "$rdiskr" ] || die "root formatting was not confirmed"
        format_filesystem "$root_fs" "$rdiskr" CRUX_ROOT
    else
        root_fs=$detected_root_fs
        [ -n "$root_fs" ] || die "could not detect a filesystem on $rdiskr"
    fi
    mount_root_target

    if is_uefi; then
        suggested_esp=$(find_esp_candidate || true)
        say ""
        [ -n "$suggested_esp" ] && say "Detected likely EFI System Partition: $suggested_esp"
        while :; do
            select_existing_partition "EFI System" no || continue
            boot=$SELECTED_BLOCK
            [ "$boot" != "$rdiskr" ] || { warn "root and EFI partitions cannot be the same"; continue; }
            break
        done
        boot_fs=$(blk_value TYPE "$boot")
        if [ "$boot_fs" != "vfat" ]; then
            warn "$boot currently reports filesystem '${boot_fs:-unknown}'"
            if confirm "Format $boot as FAT32?" "n"; then
                typed=$(ask "Type the full EFI partition path to confirm" "CANCEL")
                [ "$typed" = "$boot" ] || die "EFI formatting was not confirmed"
                have mkfs.vfat || die "mkfs.vfat is required"
                mkfs.vfat -F 32 -n EFI "$boot" || die "failed to format $boot"
            else
                die "UEFI installation requires a FAT32 EFI System Partition"
            fi
        elif confirm "Reformat the existing EFI partition? This removes every boot file on it." "n"; then
            typed=$(ask "Type the full EFI partition path to confirm" "CANCEL")
            [ "$typed" = "$boot" ] || die "EFI formatting was not confirmed"
            mkfs.vfat -F 32 -n EFI "$boot" || die "failed to format $boot"
        fi
        mkdir -p "$TARGET/boot"
        mount "$boot" "$TARGET/boot" || die "failed to mount EFI partition"
    else
        boot=""
    fi

    while :; do
        select_existing_partition "Swap" yes || continue
        sw=$SELECTED_BLOCK
        [ -z "$sw" ] && break
        [ "$sw" != "$rdiskr" ] && [ "$sw" != "$boot" ] || { warn "swap must be a different partition"; continue; }
        if is_partition_mounted "$sw"; then warn "$sw is mounted"; continue; fi
        if [ "$(blk_value TYPE "$sw")" != "swap" ]; then
            confirm "Format $sw as swap?" "y" || { sw=""; break; }
            mkswap -L swap "$sw" || die "failed to format swap partition"
        fi
        swapon "$sw" || warn "could not enable swap during installation"
        break
    done

    home=""
    home_fs=""
    if confirm "Use a separate /home partition?" "n"; then
        while :; do
            select_existing_partition "Home" no || continue
            home=$SELECTED_BLOCK
            [ "$home" != "$rdiskr" ] && [ "$home" != "$boot" ] && [ "$home" != "$sw" ] || {
                warn "/home must use a different partition"; continue;
            }
            break
        done
        detected_home_fs=$(blk_value TYPE "$home")
        if confirm "Format $home?" "n"; then
            filesystem_menu "the home partition" "${detected_home_fs:-ext4}"
            home_fs=$FS_RESULT
            typed=$(ask "Type the full home partition path to confirm" "CANCEL")
            [ "$typed" = "$home" ] || die "home formatting was not confirmed"
            format_filesystem "$home_fs" "$home" CRUX_HOME
        else
            home_fs=$detected_home_fs
            [ -n "$home_fs" ] || die "could not detect a filesystem on $home"
        fi
        mkdir -p "$TARGET/home"
        mount "$home" "$TARGET/home" || die "failed to mount $home at $TARGET/home"
    fi
}

find_iso_pkg() {
    collection=$1
    package_name=$2
    collection_dir="$MEDIA/$collection"
    [ -d "$collection_dir" ] || return 1
    find "$collection_dir" -maxdepth 1 -type f \
        \( -name "${package_name}#*.pkg.tar.gz" \
        -o -name "${package_name}#*.pkg.tar.xz" \
        -o -name "${package_name}#*.pkg.tar.zst" \
        -o -name "${package_name}#*.pkg.tar.bz2" \
        -o -name "${package_name}#*.pkg.tar.lz" \) 2>/dev/null |
        sort -V | tail -n 1
}

install_iso_pkg() {
    collection=$1
    package_name=$2
    package_file=$(find_iso_pkg "$collection" "$package_name")
    [ -n "$package_file" ] || return 1
    info "installing $package_name from the ISO $collection collection"
    pkgadd -r "$TARGET" "$package_file"
}

install_core_from_iso() {
    [ -d "$MEDIA/core" ] || die "could not find the ISO core collection at $MEDIA/core"
    mkdir -p "$TARGET/var/lib/pkg" "$TARGET/usr/src" "$TARGET/root"
    [ -f "$TARGET/var/lib/pkg/db" ] || : > "$TARGET/var/lib/pkg/db"
    info "installing the CRUX core collection from the ISO"
    found=no
    for package_file in "$MEDIA"/core/*; do
        [ -f "$package_file" ] || continue
        found=yes
        pkgadd -r "$TARGET" "$package_file" || die "failed to install ${package_file##*/}"
    done
    [ "$found" = yes ] || die "no core package archives were found on the ISO"
}

verify_base_install() {
    missing=""
    for path in /bin/sh /usr/bin/pkgadd /usr/bin/prt-get /usr/bin/ports /usr/bin/make /usr/bin/gcc; do
        [ -x "$TARGET$path" ] || missing="$missing $path"
    done
    if [ -n "$missing" ]; then
        die "the base installation is missing required target commands:$missing. Re-run the official setup and select the core development system."
    fi
}

setup_base_packages() {
    say ""
    say "Base system installation"
    say "------------------------"
    say "  1) Automatic: install every package in the ISO core collection"
    say "  2) Advanced: launch the official CRUX setup package selector"
    base_choice=$(choose_number "Base installation method" "1" 1 2)
    case "$base_choice" in
        1) base_install_method=automatic; install_core_from_iso ;;
        2) base_install_method=official; /usr/bin/setup || die "official CRUX setup failed" ;;
    esac

    if is_uefi; then
        [ -x "$TARGET/usr/sbin/grub-install" ] || install_iso_pkg opt grub2 || true
        install_iso_pkg opt grub2-efi || true
        install_iso_pkg opt efibootmgr || true
    else
        [ -x "$TARGET/usr/sbin/grub-install" ] || install_iso_pkg opt grub2 || true
    fi
    install_iso_pkg opt sudo || true
    install_iso_pkg opt prt-utils || true
    install_iso_pkg opt linux-firmware || true
    verify_base_install
}

mount_one_binding() {
    kind=$1
    source=$2
    destination=$3
    mkdir -p "$destination" || die "cannot create $destination"
    is_mounted "$destination" && return 0
    case "$kind" in
        bind) mount --bind "$source" "$destination" ;;
        proc) mount -t proc proc "$destination" ;;
        sysfs) mount -t sysfs sysfs "$destination" ;;
        devpts) mount -t devpts -o noexec,nosuid,gid=5,mode=0620 devpts "$destination" ;;
        *) return 1 ;;
    esac
}

mount_bindings() {
    info "mounting chroot pseudo-filesystems"
    mount_one_binding bind /dev "$TARGET/dev" || die "failed to bind /dev"
    mount_one_binding bind /run "$TARGET/run" || die "failed to bind /run"
    mount_one_binding proc proc "$TARGET/proc" || die "failed to mount proc"
    mount_one_binding sysfs sysfs "$TARGET/sys" || die "failed to mount sysfs"
    mount_one_binding devpts devpts "$TARGET/dev/pts" || die "failed to mount devpts"
    if is_uefi; then
        mkdir -p "$TARGET/sys/firmware/efi/efivars"
        if ! is_mounted "$TARGET/sys/firmware/efi/efivars"; then
            mount --bind /sys/firmware/efi/efivars "$TARGET/sys/firmware/efi/efivars" ||
                warn "could not bind EFI variables; grub-install may need --removable"
        fi
    fi
    bindings_mounted=yes
}

chroot_run() {
    command_text=$1
    chroot "$TARGET" /bin/sh -c "$command_text"
}

copy_resolver_configuration() {
    if [ -n "$ns1" ]; then
        rm -f "$TARGET/etc/resolv.conf"
        {
            printf 'nameserver %s\n' "$ns1"
            [ -n "$ns2" ] && printf 'nameserver %s\n' "$ns2"
        } > "$TARGET/etc/resolv.conf"
    elif [ -r /etc/resolv.conf ]; then
        rm -f "$TARGET/etc/resolv.conf"
        cp -L /etc/resolv.conf "$TARGET/etc/resolv.conf" || warn "could not copy resolver configuration"
    fi
}

configure_passwords_and_user() {
    say ""
    say "Account setup"
    say "-------------"
    say "Set the root password. Input is handled by passwd and will not be echoed."
    chroot "$TARGET" /usr/bin/passwd || die "failed to set the root password"

    while :; do
        user_name=$(ask "Local user name" "user")
        valid_username "$user_name" && break
        warn "use a lowercase name beginning with a letter or underscore; 'root' is reserved"
    done

    if grep -q "^${user_name}:" "$TARGET/etc/passwd" 2>/dev/null; then
        warn "user '$user_name' already exists; keeping the existing account"
    else
        supplementary=""
        for group in wheel audio video input storage lp; do
            if grep -q "^${group}:" "$TARGET/etc/group" 2>/dev/null; then
                supplementary="${supplementary:+$supplementary,}$group"
            fi
        done
        if [ -n "$supplementary" ]; then
            chroot "$TARGET" /usr/sbin/useradd -m -G "$supplementary" -s /bin/bash "$user_name" ||
                die "failed to create user $user_name"
        else
            chroot "$TARGET" /usr/sbin/useradd -m -s /bin/bash "$user_name" ||
                die "failed to create user $user_name"
        fi
    fi
    say "Set the password for $user_name."
    chroot "$TARGET" /usr/bin/passwd "$user_name" || die "failed to set password for $user_name"

    if [ -x "$TARGET/usr/bin/sudo" ]; then
        mkdir -p "$TARGET/etc/sudoers.d"
        printf '%%wheel ALL=(ALL:ALL) ALL\n' > "$TARGET/etc/sudoers.d/10-wheel"
        chmod 0440 "$TARGET/etc/sudoers.d/10-wheel"
    else
        warn "sudo is not installed; use su until you install and configure it"
    fi
}

set_config_value() {
    file=$1
    key=$2
    value=$3
    if grep -q "^${key}=" "$file" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${value}|" "$file"
    else
        printf '%s=%s\n' "$key" "$value" >> "$file"
    fi
}

configure_pkgmk_cache() {
    mkdir -p "$TARGET/var/cache/pkgmk/distfiles" \
             "$TARGET/var/cache/pkgmk/packages" \
             "$TARGET/var/cache/pkgmk/work"
    pkgmk_conf="$TARGET/etc/pkgmk.conf"
    [ -f "$pkgmk_conf" ] || : > "$pkgmk_conf"
    set_config_value "$pkgmk_conf" PKGMK_SOURCE_DIR '"/var/cache/pkgmk/distfiles"'
    set_config_value "$pkgmk_conf" PKGMK_PACKAGE_DIR '"/var/cache/pkgmk/packages"'
    # $name is intentionally literal; pkgmk expands it for each port.
    set_config_value "$pkgmk_conf" PKGMK_WORK_DIR '"/var/cache/pkgmk/work/$name"'
}

ensure_prtdir_line() {
    directory=$1
    config="$TARGET/etc/prt-get.conf"
    [ -f "$config" ] || : > "$config"
    grep -Fqx "prtdir $directory" "$config" 2>/dev/null ||
        printf 'prtdir %s\n' "$directory" >> "$config"
}

configure_prt_get() {
    config="$TARGET/etc/prt-get.conf"
    [ -f "$config" ] || : > "$config"
    if grep -q '^runscripts[[:space:]]' "$config" 2>/dev/null; then
        sed -i 's/^runscripts[[:space:]].*/runscripts yes/' "$config"
    else
        printf '\nrunscripts yes\n' >> "$config"
    fi
    mkdir -p "$TARGET/var/log/pkgbuild"
}

write_public_key() {
    name=$1
    comment=$2
    key=$3
    mkdir -p "$TARGET/etc/ports"
    {
        printf 'untrusted comment: %s\n' "$comment"
        printf '%s\n' "$key"
    } > "$TARGET/etc/ports/${name}.pub"
    chmod 0644 "$TARGET/etc/ports/${name}.pub"
}

write_rsync_repo() {
    name=$1
    host=$2
    collection=$3
    destination=$4
    mkdir -p "$TARGET/etc/ports"
    cat > "$TARGET/etc/ports/${name}.rsync" <<EOF
# /etc/ports/${name}.rsync
host=$host
collection=$collection
destination=$destination
# End of file
EOF
}

write_httpup_repo() {
    name=$1
    root_dir=$2
    url=$3
    mkdir -p "$TARGET/etc/ports"
    cat > "$TARGET/etc/ports/${name}.httpup" <<EOF
# /etc/ports/${name}.httpup
ROOT_DIR=$root_dir
URL=$url
# End of file
EOF
}

ensure_official_repositories() {
    # Recreate the active CRUX 3.8 definitions. This also prevents an upgrade
    # from accidentally syncing an older release through rejected config files.
    write_rsync_repo core crux.nu ports/crux-3.8/core/ /usr/ports/core
    write_public_key core "core public key"         "RWRZAkQEVz8SoR2Tu7Nhnv8Fm91/Y+HLWq7iUtixzM2w8Vv0BSkAXB8C"
    write_rsync_repo opt crux.nu ports/crux-3.8/opt/ /usr/ports/opt
    write_public_key opt "opt public key"         "RWSBCSYknENWgnHabtCJT/hAohKr9ThZ/vEZ94BgT9vFCsSFZhFZgkNr"
    write_rsync_repo xorg crux.nu ports/crux-3.8/xorg/ /usr/ports/xorg
    write_public_key xorg "xorg public key"         "RWRQdQmOIOqwe2/ZZuTSoQgMPPWm1YA/9H0L/1El2OVhj3+I4DWhKSjT"
    ensure_prtdir_line /usr/ports/core
    ensure_prtdir_line /usr/ports/opt
    ensure_prtdir_line /usr/ports/xorg
}

enable_contrib_repo() {
    if [ -f "$TARGET/etc/ports/contrib.rsync.inactive" ] && [ ! -f "$TARGET/etc/ports/contrib.rsync" ]; then
        mv "$TARGET/etc/ports/contrib.rsync.inactive" "$TARGET/etc/ports/contrib.rsync" ||
            die "failed to enable the contrib repository"
    fi
    [ -f "$TARGET/etc/ports/contrib.rsync" ] || {
        write_rsync_repo contrib crux.nu ports/crux-3.8/contrib/ /usr/ports/contrib
        write_public_key contrib "contrib public key" "RWRg1hKiTWvlRYugeIBZSkPrlcxcgubttUMVWEsWsLNwX9naXZOrQYDn"
    }
    ensure_prtdir_line /usr/ports/contrib
}

enable_compat32_repo() {
    if [ -f "$TARGET/etc/ports/compat-32.rsync.inactive" ] && [ ! -f "$TARGET/etc/ports/compat-32.rsync" ]; then
        mv "$TARGET/etc/ports/compat-32.rsync.inactive" "$TARGET/etc/ports/compat-32.rsync" ||
            die "failed to enable compat-32"
    fi
    if [ ! -f "$TARGET/etc/ports/compat-32.rsync" ]; then
        write_rsync_repo compat-32 crux.nu ports/crux-3.8/compat-32/ /usr/ports/compat-32
    fi
    write_public_key compat-32 "compat-32 public key"         "RWSKBMspqKIXKe5Sh37BEyxSuX/z/nzMQF8Mz1hNCNBJwCGu6ec8VRiB"
    ensure_prtdir_line /usr/ports/compat-32
}

