    write_httpup_repo alan /usr/ports/alan https://www.mizrahi.com.ve/crux/ports/
    write_public_key alan "alan public key" \
        "RWSHHtGdlW9unGuKcA4PJdgmwJYRTcWgwvUPPkt3DRhVSb5U90KGOFyy"
    # Keep this after all official and desktop-specific collections so duplicate
    # ports cannot silently override them.
    ensure_prtdir_line /usr/ports/alan
}

