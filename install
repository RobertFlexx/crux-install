    write_public_key xfce4 "xfce4 public key" \
        "RWRSAbUnL7azFG0NI3YD3U3PIgu839WrgGK9z4A5xwMTa5fcTz8iNW+B"
    ensure_prtdir_line /usr/ports/xfce4
}

add_custom_httpup_repo() {
    say ""
    warn "Custom repositories are not supported by the CRUX team and can override or conflict with official ports."
    warn "Only add a repository you found in the CRUX PortDB and whose Pkgfiles you trust."
    confirm "Add a custom HTTPUp repository?" "n" || return 0

    while :; do
        custom_name=$(ask "Repository name" "myports")
        valid_repo_name "$custom_name" && break
        warn "repository names may contain only letters, digits, dot, underscore, and hyphen"
    done
    custom_url=$(ask "HTTPUp repository URL" "https://example.invalid/ports")
    case "$custom_url" in
        http://*|https://*) ;;
        *) die "custom repository URL must begin with http:// or https://" ;;
    esac
    custom_key=$(ask_optional "Signify public key from PortDB" "")
    write_httpup_repo "$custom_name" "/usr/ports/$custom_name" "$custom_url"
    if [ -n "$custom_key" ]; then
        write_public_key "$custom_name" "$custom_name public key" "$custom_key"
    else
        warn "no public key was supplied; package source signatures from this collection cannot be authenticated"
    fi
    # Deliberately append after official collections. prt-get searches in order,
    # so the custom collection will not silently replace an official duplicate.
    ensure_prtdir_line "/usr/ports/$custom_name"
}

sync_ports_trees() {
    info "synchronizing configured ports collections with ports -u"

    # prt-get manages packages from an already-synchronized ports tree; it has
    # no 'sync' subcommand. CRUX updates collection trees with the ports tool.
    if [ -x "$TARGET/usr/bin/ports" ]; then
        chroot "$TARGET" /usr/bin/ports -u || die "ports -u failed"
    elif [ -x "$TARGET/usr/sbin/ports" ]; then
        chroot "$TARGET" /usr/sbin/ports -u || die "ports -u failed"
    else
        die "the CRUX ports updater was not found in the target system"
    fi
}

port_exists() {
    package_name=$1
    valid_package_name "$package_name" || return 1
    chroot "$TARGET" /usr/bin/prt-get info "$package_name" >/dev/null 2>&1
}

install_required_ports() {
    description=$1
    shift
    package_list=""
    for package_name in "$@"; do
        valid_package_name "$package_name" || die "invalid package name '$package_name'"
        if port_exists "$package_name"; then
            package_list="${package_list:+$package_list }$package_name"
        else
            die "required port '$package_name' for $description was not found in the configured collections"
        fi
    done
    [ -n "$package_list" ] || return 0
    info "installing $description: $package_list"
    chroot_run "prt-get depinst $package_list" || die "failed to install $description"
}

install_optional_ports() {
    description=$1
    shift
    package_list=""
    for package_name in "$@"; do
        valid_package_name "$package_name" || continue
        if port_exists "$package_name"; then
            package_list="${package_list:+$package_list }$package_name"
        else
            warn "optional port '$package_name' is unavailable; skipping it"
        fi
    done
    [ -n "$package_list" ] || return 0
    info "installing $description: $package_list"
    chroot_run "prt-get depinst $package_list" || warn "one or more optional $description ports failed to install"
}

configure_privilege_escalation() {
    if [ ! -x "$TARGET/usr/bin/sudo" ] && port_exists sudo; then
        if confirm "Install sudo for the wheel group?" "y"; then
            install_required_ports "sudo" sudo
        fi
    fi
    if [ -x "$TARGET/usr/bin/sudo" ]; then
        mkdir -p "$TARGET/etc/sudoers.d"
        printf '%%wheel ALL=(ALL:ALL) ALL\n' > "$TARGET/etc/sudoers.d/10-wheel"
        chmod 0440 "$TARGET/etc/sudoers.d/10-wheel"
        if [ -x "$TARGET/usr/sbin/visudo" ]; then
            chroot "$TARGET" /usr/sbin/visudo -cf /etc/sudoers >/dev/null ||                 die "sudoers validation failed"
        elif [ -x "$TARGET/usr/bin/visudo" ]; then
            chroot "$TARGET" /usr/bin/visudo -cf /etc/sudoers >/dev/null ||                 die "sudoers validation failed"
        fi
    fi
}

detect_gpu_vendor() {
    vendors=""
    gpu_lines=""
    if have lspci; then
        gpu_lines=$(lspci -nn 2>/dev/null | grep -Ei 'VGA compatible controller|3D controller|Display controller' || true)
        printf '%s\n' "$gpu_lines" | grep -qi 'NVIDIA' && vendors="$vendors nvidia"
        printf '%s\n' "$gpu_lines" | grep -Eqi 'AMD|ATI' && vendors="$vendors amd"
        printf '%s\n' "$gpu_lines" | grep -qi 'Intel' && vendors="$vendors intel"
        printf '%s\n' "$gpu_lines" | grep -Eqi 'VMware' && vendors="$vendors vmware"
        printf '%s\n' "$gpu_lines" | grep -Eqi 'VirtualBox|InnoTek' && vendors="$vendors virtualbox"
    else
        for vendor_file in /sys/bus/pci/devices/*/vendor; do
            [ -r "$vendor_file" ] || continue
            class_file=${vendor_file%/vendor}/class
            class=$(cat "$class_file" 2>/dev/null || true)
            case "$class" in 0x03*) ;; *) continue ;; esac
            vendor=$(cat "$vendor_file" 2>/dev/null || true)
            case "$vendor" in
                0x10de) vendors="$vendors nvidia" ;;
                0x1002) vendors="$vendors amd" ;;
                0x8086) vendors="$vendors intel" ;;
                0x15ad) vendors="$vendors vmware" ;;
                0x80ee) vendors="$vendors virtualbox" ;;
            esac
        done
    fi
    vendors=$(printf '%s\n' "$vendors" | tr ' ' '\n' | sed '/^$/d' | awk '!seen[$0]++' | paste -sd+ -)
    [ -n "$vendors" ] || vendors=generic
    detected_gpu=$vendors
}

choose_nvidia_module_flavor() {
    # CRUX's nvidia port supports both NVIDIA's open kernel modules and the
    # traditional proprietary kernel modules. Open modules support Turing and
    # newer hardware; the proprietary flavor remains necessary for older GPUs.
    default_choice=2
    case "$gpu_lines" in
        *RTX*|*"GTX 16"*|*Turing*|*TU10*|*TU11*|*Ampere*|*Ada*|*Hopper*) default_choice=1 ;;
    esac
    say ""
    say "NVIDIA kernel-module flavor"
    say "---------------------------"
    [ -n "$gpu_lines" ] && printf '%s\n' "$gpu_lines" | sed 's/^/  Detected: /'
    say "  1) Open NVIDIA kernel modules (RTX 20 / GTX 16 / Turing or newer)"
    say "  2) Proprietary kernel modules (GTX 10 / Pascal or older; broad fallback)"
    module_choice=$(choose_number "NVIDIA module flavor" "$default_choice" 1 2)
    case "$module_choice" in
        1) nvidia_proprietary_modules=0 ;;
        2) nvidia_proprietary_modules=1 ;;
    esac
}

choose_gpu_driver() {
    detect_gpu_vendor
    say ""
    say "Graphics driver"
    say "---------------"
    say "Detected graphics: $detected_gpu"
    say "  1) Automatic detection (recommended)"
    say "  2) NVIDIA proprietary/open-kernel-module package"
    say "  3) AMD Mesa + amdgpu"
    say "  4) Intel Mesa"
    say "  5) Generic/virtual-machine Xorg drivers"
    gpu_number=$(choose_number "Graphics profile" "1" 1 5)
    case "$gpu_number" in
        1)
            case "$detected_gpu" in
                *nvidia*) selected_gpu=nvidia ;;
                *amd*) selected_gpu=amd ;;
                *intel*) selected_gpu=intel ;;
                *vmware*) selected_gpu=vmware ;;
                *virtualbox*) selected_gpu=virtualbox ;;
                *) selected_gpu=generic ;;
            esac
            ;;
        2) selected_gpu=nvidia ;;
        3) selected_gpu=amd ;;
        4) selected_gpu=intel ;;
        5) selected_gpu=generic ;;
    esac
    [ "$selected_gpu" = nvidia ] && choose_nvidia_module_flavor
    info "graphics profile: $selected_gpu (detected: $detected_gpu)"
}

collect_optional_choices() {
    say ""
    say "Installation profile"
    say "--------------------"
    say "  1) Full KDE Plasma 6 desktop (recommended)"
    say "  2) Minimal console system"
    desktop_number=$(choose_number "System profile" "1" 1 2)
    case "$desktop_number" in
        1)
            desktop_choice=kde
            desktop_label="KDE Plasma 6"
            desktop_session_cmd='exec ck-launch-session dbus-run-session -- startplasma-x11'
            use_networkmanager=yes
            install_pipewire=yes
            install_flatpak=yes
            install_discover=yes
            choose_gpu_driver
            say ""
            say "Graphical login"
            say "  1) XDM from the official xorg collection (recommended, reliable)"
            say "  2) SDDM from the signed community 'alan' collection"
            say "  3) No display manager; log in and run startx"
            dm_number=$(choose_number "Display manager" "1" 1 3)
            case "$dm_number" in
                1) display_manager=xdm; use_xdm=yes ;;
                2)
                    warn "SDDM is not in CRUX core/opt/xorg/compat-32; it comes from a community collection."
                    confirm "Enable the signed alan collection for SDDM?" "n" || {
                        warn "using official XDM instead"; display_manager=xdm; use_xdm=yes; dm_number=1;
                    }
                    if [ "$dm_number" = 2 ]; then
                        display_manager=sddm
                        enable_alan_sddm=yes
                        use_xdm=no
                    fi
                    ;;
                3) display_manager=none; use_xdm=no ;;
            esac
            install_firmware=yes
            confirm "Enable Bluetooth support?" "y" && install_bluetooth=yes || install_bluetooth=no
            confirm "Enable printing support (CUPS)?" "n" && install_printing=yes || install_printing=no
            confirm "Enable 32-bit libraries for Steam/Wine/games?" "y" && {
                enable_compat32=yes
                install_gaming32=yes
            } || {
                enable_compat32=no
                install_gaming32=no
            }
            ;;
        2)
            desktop_choice=none
            desktop_label=""
            display_manager=none
            use_xdm=no
            use_networkmanager=no
            install_pipewire=no
            install_flatpak=no
            enable_compat32=no
            selected_gpu=generic
            confirm "Install Flatpak on the console system?" "n" && install_flatpak=yes || true
            ;;
    esac

    confirm "Synchronize ports and update installed packages before building the desktop?" "y" && update_ports_now=yes || update_ports_now=no
    say ""
    say "CRUX has no official rolling 'unstable' collection."
    say "Community collections may be newer, but they are not an unstable branch."
    confirm "Show the advanced custom-repository prompt?" "n" && advanced_repositories=yes || advanced_repositories=no
}

configure_repositories() {
    configure_pkgmk_cache
    configure_prt_get
    ensure_official_repositories

    case "$desktop_choice" in
        kde) enable_kde_repo ;;
        xfce) enable_xfce_repo ;;
    esac

    if [ "$desktop_choice" != none ] || [ "$use_networkmanager" = yes ] || [ "$install_flatpak" = yes ] || [ "$install_pipewire" = yes ]; then
        enable_contrib_repo
    fi
    [ "$enable_compat32" = yes ] && enable_compat32_repo
    [ "$enable_alan_sddm" = yes ] && enable_alan_repo_for_sddm
    [ "$advanced_repositories" = yes ] && add_custom_httpup_repo
    sync_ports_trees
}

verify_selected_port_plan() {
    [ "$desktop_choice" != none ] || return 0
    required="xorg dbus consolekit polkit networkmanager pipewire wireplumber alsa-utils alsa-ucm-conf plasma-meta kwin-x11 konsole dolphin polkit-kde-agent-1 plasma-nm plasma-pa"
    [ "$install_flatpak" = yes ] && required="$required flatpak xdg-desktop-portal xdg-desktop-portal-kde discover"
    case "$selected_gpu" in
        nvidia)
            required="$required nvidia"
            [ "$install_gaming32" = yes ] && required="$required nvidia-32"
            ;;
        amd)
            required="$required vulkan-loader glslang mesa xorg-xf86-video-amdgpu xorg-xf86-video-ati"
            [ "$install_gaming32" = yes ] && required="$required vulkan-loader-32 mesa-32"
            ;;
        intel)
            required="$required vulkan-loader glslang libclc python3-ply lua mesa"
            [ "$install_gaming32" = yes ] && required="$required vulkan-loader-32 mesa-32"
            ;;
    esac
    case "$display_manager" in xdm) required="$required xorg-xdm" ;; sddm) required="$required sddm" ;; esac
    missing=""
    for pkg in $required; do
        port_exists "$pkg" || missing="$missing $pkg"
    done
    [ -z "$missing" ] || die "selected profile cannot be built because these ports are missing:$missing"
    info "all required ports for the selected profile exist"
}

prepare_graphics_stack() {
    # Mesa decides which Vulkan drivers to build by checking which development
    # tools are already installed. Install those tools before any KDE/Qt
    # dependency can pull Mesa into the system.
    [ "$desktop_choice" != none ] || return 0
    case "$selected_gpu" in
        amd)
            install_required_ports "AMD Vulkan build prerequisites" vulkan-loader glslang
            install_required_ports "AMD Mesa graphics" mesa xorg-xf86-video-amdgpu xorg-xf86-video-ati
            ;;
        intel)
            install_required_ports "Intel Vulkan build prerequisites" \
                vulkan-loader glslang libclc python3-ply lua
            install_required_ports "Intel Mesa graphics" mesa
            install_optional_ports "legacy Intel Xorg driver" xorg-xf86-video-intel
            ;;
        vmware)
            install_optional_ports "VMware graphics" xorg-xf86-video-vmware open-vm-tools
            ;;
        virtualbox)
            install_optional_ports "VirtualBox graphics" xorg-xf86-video-vboxvideo
            ;;
        generic)
            install_optional_ports "generic Xorg graphics" xorg-xf86-video-vesa
            ;;
    esac
}

prepare_flatpak_stack() {
    [ "$install_flatpak" = yes ] || return 0
    # Install Flatpak before Discover so Discover's build sees its backend.
    install_required_ports "Flatpak base" flatpak xdg-desktop-portal xdg-utils xdg-user-dirs
}

configure_desktop() {
    [ "$desktop_choice" != none ] || return 0

    install_required_ports "the Xorg desktop base" xorg dbus consolekit polkit

    if [ "$use_networkmanager" = yes ]; then
        install_required_ports "NetworkManager" networkmanager
        install_optional_ports "wireless support" wpa_supplicant iwd
    fi

    if [ "$install_pipewire" = yes ]; then
        install_required_ports "PipeWire audio" pipewire wireplumber alsa-utils alsa-ucm-conf
        install_optional_ports "audio controls" pavucontrol
    fi

    case "$desktop_choice" in
        kde)
            # The KDE repository itself recommends plasma-meta as the starting point.
            install_required_ports "KDE Plasma 6" \
                plasma-meta kwin-x11 konsole dolphin polkit-kde-agent-1 plasma-nm plasma-pa
            [ "$install_flatpak" = yes ] && install_required_ports "KDE Discover" discover
            install_optional_ports "KDE desktop applications" \
                ark kate gwenview okular partitionmanager spectacle filelight kcalc \
                plasma-systemmonitor plasma-welcome kscreen kinfocenter
            install_optional_ports "KDE desktop integration" \
                powerdevil upower udisks2 breeze-gtk kde-gtk-config
            install_optional_ports "desktop fonts and firmware" \
                xorg-font-dejavu-ttf otf-noto linux-firmware
            ;;
        xfce)
            install_required_ports "Xfce" xfce4
            ;;
    esac

    case "$display_manager" in
        xdm)
            install_required_ports "XDM" xorg-xdm
            service_exists xdm || die "xorg-xdm installed but /etc/rc.d/xdm is missing"
            ;;
        sddm)
            install_required_ports "SDDM" sddm
            service_exists sddm || die "the community sddm port did not provide /etc/rc.d/sddm; choose official XDM"
            ;;
    esac

    if [ "$install_bluetooth" = yes ]; then
        install_optional_ports "Bluetooth" bluez
    fi
    if [ "$install_printing" = yes ]; then
        install_optional_ports "printing" cups cups-filters
    fi

    setup_desktop_session_files
    configure_display_manager
}

setup_desktop_session_files() {
    [ "$desktop_choice" != none ] || return 0
    user_home="$TARGET/home/$user_name"
    [ -d "$user_home" ] || return 0

    case "$desktop_choice" in
        kde) session_program=startplasma-x11 ;;
        xfce) session_program=startxfce4 ;;
        *) return 0 ;;
    esac

    session_file="$user_home/.xsession"
    cat > "$session_file" <<EOF
#!/bin/sh
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=KDE

# ConsoleKit supplies session/seat tracking on stock CRUX. Keep ConsoleKit
# outside the per-user D-Bus session so both see the whole desktop process.
exec ck-launch-session dbus-run-session -- $session_program
EOF
    cp "$session_file" "$user_home/.xinitrc"
    chmod 0755 "$session_file" "$user_home/.xinitrc"

    if [ "$install_pipewire" = yes ]; then
        mkdir -p "$user_home/.local/bin" "$user_home/.config/autostart"
        audio_start="$user_home/.local/bin/crux-start-pipewire"
        cat > "$audio_start" <<'EOF'
#!/bin/sh
if ! pgrep -x pipewire >/dev/null 2>&1; then
    pipewire >/tmp/pipewire.log 2>&1 &
fi
if ! pgrep -x pipewire-pulse >/dev/null 2>&1; then
    pipewire-pulse >/tmp/pipewire-pulse.log 2>&1 &
fi
if ! pgrep -x wireplumber >/dev/null 2>&1; then
    wireplumber >/tmp/wireplumber.log 2>&1 &
fi
exit 0
EOF
        chmod 0755 "$audio_start"
        cat > "$user_home/.config/autostart/crux-pipewire.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=PipeWire audio session
Exec=/home/$user_name/.local/bin/crux-start-pipewire
X-KDE-autostart-after=panel
NoDisplay=true
EOF
    fi

    chroot "$TARGET" /bin/chown "$user_name:$user_name" "/home/$user_name/.xsession" "/home/$user_name/.xinitrc" || true
    [ -d "$user_home/.config" ] && chroot "$TARGET" /bin/chown -R "$user_name:$user_name" "/home/$user_name/.config" || true
    [ -d "$user_home/.local" ] && chroot "$TARGET" /bin/chown -R "$user_name:$user_name" "/home/$user_name/.local" || true
}

configure_display_manager() {
    case "$display_manager" in
        xdm)
            xdm_dir="$TARGET/etc/X11/xdm"
            [ -d "$xdm_dir" ] || return 0
            # XDM runs ~/.xsession through Xsession on CRUX. Make the login box
            # less prehistoric without depending on an unsupported theme stack.
            if [ -f "$xdm_dir/Xresources" ]; then
                cat >> "$xdm_dir/Xresources" <<'EOF'

! CRUX Easy Installer defaults
xlogin*login.translations: #override Ctrl<Key>R: abort-display()\n<Key>F1: set-session-argument(failsafe) finish-field()\n<Key>Return: set-session-argument() finish-field()
xlogin*greeting: CRUX KDE Plasma
xlogin*namePrompt: Login:\040
xlogin*passwdPrompt: Password:\040
EOF
            fi
            ;;
        sddm)
            mkdir -p "$TARGET/etc/sddm.conf.d"
            cat > "$TARGET/etc/sddm.conf.d/10-crux-kde.conf" <<EOF
[General]
DisplayServer=x11

[Theme]
Current=breeze

[Users]
RememberLastUser=true
RememberLastSession=true

EOF
            ;;
    esac
}

configure_flatpak() {
    [ "$install_flatpak" = yes ] || return 0
    # Base packages were installed before KDE/Discover; verify rather than rebuild.
    install_required_ports "Flatpak base" flatpak xdg-desktop-portal xdg-utils xdg-user-dirs
    case "$desktop_choice" in
        kde) install_required_ports "KDE Flatpak portal" xdg-desktop-portal-kde ;;
        *) install_optional_ports "GTK Flatpak portal" xdg-desktop-portal-gtk ;;
    esac
    if chroot "$TARGET" /usr/bin/flatpak remote-add --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo; then
        info "added the Flathub system remote"
    else
        warn "Flatpak installed, but adding Flathub failed; retry after first boot"
    fi
}

update_installed_ports() {
    [ "$update_ports_now" = yes ] || return 0
    say ""
    warn "A full ports update compiles packages from source and can take a long time."
    info "updating installed packages with prt-get sysup"
    chroot "$TARGET" /usr/bin/prt-get sysup ||
        warn "prt-get sysup reported a failure; inspect the build output and $TARGET/var/log/pkgbuild"

    if chroot "$TARGET" /usr/bin/prt-get info prt-utils >/dev/null 2>&1; then
        if [ ! -x "$TARGET/usr/bin/revdep" ] && [ ! -x "$TARGET/usr/sbin/revdep" ]; then
            chroot "$TARGET" /usr/bin/prt-get depinst prt-utils || true
        fi
    fi
}

install_gpu_drivers() {
    [ "$desktop_choice" != none ] || return 0
    case "$selected_gpu" in
        nvidia)
            [ -n "$kernel_version" ] || die "kernel version is unknown; cannot build NVIDIA modules"
            mkdir -p "$TARGET/lib/modules/$kernel_version"
            ln -snf "/usr/src/linux-$kernel_version" "$TARGET/lib/modules/$kernel_version/build"
            info "building the NVIDIA driver for target kernel $kernel_version"
            chroot_run "export KVER='$kernel_version'; export NVIDIA_PROPRIETARY_MODULES='$nvidia_proprietary_modules'; prt-get depinst nvidia" || \
                die "NVIDIA driver build failed for kernel $kernel_version"
            if [ "$install_gaming32" = yes ]; then
                install_required_ports "32-bit NVIDIA libraries" nvidia-32
            fi
            chroot "$TARGET" /sbin/depmod -a "$kernel_version" || warn "depmod failed for $kernel_version"
            mkdir -p "$TARGET/etc/modprobe.d"
            cat > "$TARGET/etc/modprobe.d/nvidia.conf" <<'EOF'
options nvidia_drm modeset=1 fbdev=1
blacklist nouveau
EOF
            ;;
        amd|intel)
            # The 64-bit Mesa stack was deliberately built before KDE so its
            # optional Vulkan drivers were enabled. Add multilib after that.
            if [ "$install_gaming32" = yes ]; then
                install_required_ports "32-bit Mesa/Vulkan graphics" vulkan-loader-32 mesa-32
            fi
            ;;
        vmware|virtualbox|generic)
            # User-space Xorg drivers were installed before KDE.
            ;;
    esac
}

configure_gpu_boot() {
    grub_file="$TARGET/etc/default/grub"
    [ -f "$grub_file" ] || return 0
    case "$selected_gpu" in
        nvidia)
            current=$(sed -n 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"/\1/p' "$grub_file" | head -n1)
            case " $current " in *' nvidia_drm.modeset=1 '*) ;; *) current="$current nvidia_drm.modeset=1" ;; esac
            sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"$(printf '%s' "$current" | sed 's/^ *//')\"|" "$grub_file"
            ;;
    esac
}

write_locale_configuration() {
    if [ "$locale_name" = "C.UTF-8" ] || [ "$locale_name" = "C" ] || [ "$locale_name" = "POSIX" ]; then
        return 0
    fi
    if [ -f "$TARGET/etc/locale.gen" ]; then
        escaped=$(printf '%s' "$locale_name" | sed 's/[.[\*^$]/\\&/g')
        if grep -q "^[#[:space:]]*${escaped}[[:space:]]" "$TARGET/etc/locale.gen"; then
            sed -i "s|^[#[:space:]]*${escaped}[[:space:]].*|${locale_name} UTF-8|" "$TARGET/etc/locale.gen"
        else
            printf '%s UTF-8\n' "$locale_name" >> "$TARGET/etc/locale.gen"
        fi
        if [ -x "$TARGET/usr/sbin/locale-gen" ]; then
            chroot "$TARGET" /usr/sbin/locale-gen || warn "locale-gen failed"
        elif [ -x "$TARGET/usr/bin/locale-gen" ]; then
            chroot "$TARGET" /usr/bin/locale-gen || warn "locale-gen failed"
        else
            warn "locale-gen is unavailable; keeping the locale configuration for first boot"
        fi
    fi
    mkdir -p "$TARGET/etc/profile.d"
    printf 'export LANG=%s\n' "$locale_name" > "$TARGET/etc/profile.d/locale.sh" 2>/dev/null || true
}

write_fstab() {
    root_uuid=$(blk_value UUID "$rdiskr")
    root_pass=$(fsck_pass "$root_fs" 1)
    boot_uuid=""
    swap_uuid=""
    home_uuid=""
    [ -n "$boot" ] && boot_uuid=$(blk_value UUID "$boot")
    [ -n "$sw" ] && swap_uuid=$(blk_value UUID "$sw")
    [ -n "$home" ] && home_uuid=$(blk_value UUID "$home")

    {
        printf '# /etc/fstab generated by CRUX Enhanced Installer %s\n' "$VERSION"
        if [ -n "$root_uuid" ]; then
            printf 'UUID=%s / %s defaults 0 %s\n' "$root_uuid" "$root_fs" "$root_pass"
        else
            printf '%s / %s defaults 0 %s\n' "$rdiskr" "$root_fs" "$root_pass"
        fi
        if [ -n "$boot" ]; then
            if [ -n "$boot_uuid" ]; then
                printf 'UUID=%s /boot vfat umask=0077 0 2\n' "$boot_uuid"
            else
                printf '%s /boot vfat umask=0077 0 2\n' "$boot"
            fi
        fi
        if [ -n "$home" ]; then
            home_pass=$(fsck_pass "$home_fs" 2)
            if [ -n "$home_uuid" ]; then
                printf 'UUID=%s /home %s defaults 0 %s\n' "$home_uuid" "$home_fs" "$home_pass"
            else
                printf '%s /home %s defaults 0 %s\n' "$home" "$home_fs" "$home_pass"
            fi
        fi
        if [ -n "$sw" ]; then
            if [ -n "$swap_uuid" ]; then
                printf 'UUID=%s none swap sw 0 0\n' "$swap_uuid"
            else
                printf '%s none swap sw 0 0\n' "$sw"
            fi
        fi
        printf 'devpts /dev/pts devpts noexec,nosuid,gid=5,mode=0620 0 0\n'
        printf 'tmpfs /dev/shm tmpfs nosuid,nodev 0 0\n'
    } > "$TARGET/etc/fstab"
}

configure_classic_network() {
    [ -n "$nic_conf" ] || return 0
    net_script="$TARGET/etc/rc.d/net"
    [ -f "$net_script" ] || { warn "target has no /etc/rc.d/net script"; return 0; }
    case "$ip_mode" in
        dhcp)
            sed -i \
                -e 's/^TYPE=.*/TYPE="DHCP"/' \
                -e "s|^DEV=.*|DEV=$nic_conf|" \
                -e 's|^DHCPOPTS=.*|DHCPOPTS="-h `/bin/hostname` -t 10"|' \
                "$net_script" || warn "failed to update DHCP settings"
            ;;
        static)
            sed -i \
                -e 's/^TYPE=.*/TYPE="static"/' \
                -e "s|^DEV=.*|DEV=$nic_conf|" \
                -e "s|^ADDR=.*|ADDR=$ip_addr|" \
                -e "s|^MASK=.*|MASK=$subnet_mask|" \
                -e "s|^GW=.*|GW=$gateway|" \
                "$net_script" || warn "failed to update static network settings"
            ;;
    esac
}

build_services_list() {
    services_list=""
    add_service lo
    [ "$desktop_choice" != none ] && service_exists dbus && add_service dbus
    if [ "$use_networkmanager" = yes ] && service_exists networkmanager; then
        add_service networkmanager
    elif [ -n "$nic_conf" ] && service_exists net; then
        add_service net
    fi
    [ "$install_bluetooth" = yes ] && service_exists bluetooth && add_service bluetooth
    [ "$install_bluetooth" = yes ] && service_exists bluez && add_service bluez
    [ "$install_printing" = yes ] && service_exists cups && add_service cups
    [ "$selected_gpu" = nvidia ] && service_exists nvidia-powerd && add_service nvidia-powerd
    service_exists crond && add_service crond
    if service_exists sshd; then
        if [ "$enable_sshd" = ask ]; then
            confirm "Enable the SSH server at boot?" "n" && enable_sshd=yes || enable_sshd=no
        fi
        [ "$enable_sshd" = yes ] && add_service sshd
    fi
    [ "$install_pipewire" = yes ] && service_exists alsa && add_service alsa
    case "$display_manager" in
        xdm) service_exists xdm && add_service xdm ;;
        sddm) service_exists sddm && add_service sddm ;;
    esac
}

write_system_configuration() {
    mkdir -p "$TARGET/etc"
    write_fstab

    cat > "$TARGET/etc/hosts" <<EOF
127.0.0.1 localhost
127.0.1.1 $hostn.localdomain $hostn
::1       localhost ip6-localhost ip6-loopback
EOF

    printf '%s\n' "$hostn" > "$TARGET/etc/hostname"
    if [ "$tzone" != "UTC" ] && [ -e "$TARGET/usr/share/zoneinfo/$tzone" ]; then
        ln -snf "/usr/share/zoneinfo/$tzone" "$TARGET/etc/localtime" || true
    elif [ -e "$TARGET/usr/share/zoneinfo/UTC" ]; then
        ln -snf /usr/share/zoneinfo/UTC "$TARGET/etc/localtime" || true
    fi

    if [ "$use_networkmanager" != yes ]; then
        configure_classic_network
    fi
    build_services_list

    cat > "$TARGET/etc/rc.conf" <<EOF
#
# /etc/rc.conf: system configuration
# Generated by CRUX Enhanced Installer $VERSION
#

FONT=default
KEYMAP=$keymap
TIMEZONE=$tzone
HOSTNAME=$hostn
SYSLOG=sysklogd
SERVICES=($services_list)

# End of file
EOF
    write_locale_configuration
}

kernel_archive() {
    find "$MEDIA/kernel" -maxdepth 1 -type f -name 'linux-*.tar.*' 2>/dev/null | sort -V | tail -n 1
}

unpack_kernel() {
    archive=$(kernel_archive)
    [ -n "$archive" ] || die "could not find a Linux kernel source archive under $MEDIA/kernel"
    base=${archive##*/}
    kernel_version=$(printf '%s' "$base" | sed -e 's/^linux-//' -e 's/\.tar\..*$//')
    kernel_dir="$TARGET/usr/src/linux-$kernel_version"

    if [ -d "$kernel_dir" ]; then
        if confirm "Kernel source $kernel_version already exists. Reuse it?" "y"; then
            return 0
        fi
        rm -rf "$kernel_dir" || die "failed to remove old kernel source"
    fi

    info "unpacking Linux $kernel_version sources"
    mkdir -p "$TARGET/usr/src"
    tar -C "$TARGET/usr/src" -xf "$archive" || die "failed to unpack $archive"

    defconfig="$MEDIA/kernel/linux-$kernel_version.defconfig"
    modular="$MEDIA/kernel/contrib/config-$kernel_version-modular"
    if [ -f "$defconfig" ]; then
        cp "$defconfig" "$kernel_dir/.config" || die "failed to copy the ISO kernel config"
    elif [ -f "$modular" ]; then
        cp "$modular" "$kernel_dir/.config" || die "failed to copy the modular kernel config"
        warn "only a modular example config was found; an initramfs may be required"
    else
        warn "no ISO kernel config matched Linux $kernel_version; make defconfig will be used"
        chroot_run "cd /usr/src/linux-$kernel_version && make defconfig" || die "make defconfig failed"
    fi
    chown -R root:root "$kernel_dir"
}

force_root_fs_builtin() {
    case "$root_fs" in
        ext2|ext3|ext4) root_symbol=EXT4_FS ;;
        btrfs) root_symbol=BTRFS_FS ;;
        xfs) root_symbol=XFS_FS ;;
        jfs) root_symbol=JFS_FS ;;
        *) root_symbol="" ;;
    esac
    config="$kernel_dir/.config"
    [ -f "$config" ] || return 0
    symbols="DEVTMPFS DEVTMPFS_MOUNT TMPFS EFI_PARTITION BLOCK BLK_DEV_SD SCSI SATA_AHCI NVME_CORE BLK_DEV_NVME"
    [ -n "$root_symbol" ] && symbols="$symbols $root_symbol"
    case "$selected_gpu" in
        amd) symbols="$symbols DRM DRM_AMDGPU" ;;
        intel) symbols="$symbols DRM DRM_I915" ;;
        nvidia) symbols="$symbols DRM DRM_SIMPLEDRM" ;;
    esac
    if [ -x "$kernel_dir/scripts/config" ]; then
        for symbol in $symbols; do
            chroot_run "cd /usr/src/linux-$kernel_version && scripts/config --enable $symbol" || \
                warn "could not force CONFIG_$symbol=y"
        done
        [ "$selected_gpu" = nvidia ] && chroot_run "cd /usr/src/linux-$kernel_version && scripts/config --disable DRM_NOUVEAU" || true
    else
        for symbol in $symbols; do
            sed -i \
                -e "s/^CONFIG_${symbol}=m$/CONFIG_${symbol}=y/" \
                -e "s/^# CONFIG_${symbol} is not set$/CONFIG_${symbol}=y/" \
                "$config"
            grep -q "^CONFIG_${symbol}=y$" "$config" || printf 'CONFIG_%s=y\n' "$symbol" >> "$config"
        done
    fi
}

build_kernel() {
    say ""
    say "Kernel installation"
    say "-------------------"
    unpack_kernel
    force_root_fs_builtin
    chroot_run "cd /usr/src/linux-$kernel_version && make olddefconfig" || die "make olddefconfig failed"

    if confirm "Open kernel menuconfig for expert changes?" "n"; then
        chroot_run "cd /usr/src/linux-$kernel_version && make menuconfig" || die "kernel menuconfig failed"
    fi

    jobs=$(nproc 2>/dev/null || printf 1)
    valid_uint "$jobs" || jobs=1
    [ "$jobs" -ge 1 ] || jobs=1
    info "building Linux $kernel_version with $jobs parallel jobs"
    chroot_run "cd /usr/src/linux-$kernel_version && make -j$jobs bzImage modules" || die "kernel build failed"
    chroot_run "cd /usr/src/linux-$kernel_version && make modules_install" || die "kernel modules installation failed"

    image="$kernel_dir/arch/x86/boot/bzImage"
    [ -f "$image" ] || die "kernel image was not produced at $image"
    cp "$image" "$TARGET/boot/vmlinuz-$kernel_version" || die "failed to install kernel image"
    cp "$kernel_dir/System.map" "$TARGET/boot/System.map-$kernel_version" || die "failed to install System.map"
    cp "$kernel_dir/.config" "$TARGET/boot/config-$kernel_version" || die "failed to save kernel config"
    ln -snf "vmlinuz-$kernel_version" "$TARGET/boot/vmlinuz"
    mkdir -p "$TARGET/lib/modules/$kernel_version"
    ln -snf "/usr/src/linux-$kernel_version" "$TARGET/lib/modules/$kernel_version/build"
    chroot "$TARGET" /sbin/depmod -a "$kernel_version" 2>/dev/null || true
    info "installed Linux $kernel_version"
}

ensure_bootloader_tools() {
    if [ ! -x "$TARGET/usr/sbin/grub-install" ] && [ ! -x "$TARGET/usr/bin/grub-install" ]; then
        install_iso_pkg opt grub2 || die "grub-install is missing and opt/grub2 was not found on the ISO"
    fi
    if is_uefi; then
        install_iso_pkg opt grub2-efi || true
        install_iso_pkg opt efibootmgr || true
    fi
}

install_bootloader() {
    say ""
    say "GRUB bootloader"
    say "---------------"
    ensure_bootloader_tools
    mkdir -p "$TARGET/etc/default"
    if [ ! -f "$TARGET/etc/default/grub" ]; then
        cat > "$TARGET/etc/default/grub" <<EOF
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR=CRUX
GRUB_CMDLINE_LINUX_DEFAULT="loglevel=4"
EOF
    fi

    if is_uefi; then
        [ -n "$boot" ] || die "no EFI System Partition was selected"
        is_mounted "$TARGET/boot" || die "EFI System Partition is not mounted at $TARGET/boot"
        info "installing GRUB for x86_64 UEFI"
        if ! chroot_run 'grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=CRUX --recheck'; then
            warn "normal EFI NVRAM installation failed"
            if confirm "Try the removable-media fallback path?" "y"; then
                chroot_run 'grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=CRUX --removable --recheck' ||
                    die "GRUB UEFI installation failed"
            else
                die "GRUB UEFI installation failed"
            fi
        fi
    else
        info "installing GRUB for legacy BIOS on $rdisk"
        chroot_run "grub-install --target=i386-pc --recheck $rdisk" || die "GRUB BIOS installation failed"
    fi
    configure_gpu_boot
    chroot_run 'grub-mkconfig -o /boot/grub/grub.cfg' || die "grub-mkconfig failed"
}

validate_installation() {
    say ""
    say "Final validation"
    say "----------------"
    failures=""
    [ -s "$TARGET/etc/fstab" ] || failures="$failures /etc/fstab"
    [ -s "$TARGET/etc/rc.conf" ] || failures="$failures /etc/rc.conf"
    [ -s "$TARGET/boot/vmlinuz-$kernel_version" ] || failures="$failures kernel-image"
    [ -s "$TARGET/boot/grub/grub.cfg" ] || failures="$failures grub.cfg"
    [ -x "$TARGET/usr/bin/prt-get" ] || failures="$failures prt-get"
    grep -q "^${user_name}:" "$TARGET/etc/passwd" 2>/dev/null || failures="$failures user-account"
    if [ "$desktop_choice" = kde ]; then
        [ -x "$TARGET/usr/bin/startplasma-x11" ] || failures="$failures startplasma-x11"
        [ -x "$TARGET/usr/bin/konsole" ] || failures="$failures konsole"
        [ -x "$TARGET/usr/bin/dolphin" ] || failures="$failures dolphin"
        [ -x "$TARGET/usr/bin/ck-launch-session" ] || failures="$failures ck-launch-session"
        [ -x "$TARGET/usr/bin/dbus-run-session" ] || failures="$failures dbus-run-session"
    fi
    case "$display_manager" in
        xdm)
            [ -x "$TARGET/etc/rc.d/xdm" ] || failures="$failures xdm-service"
            case " $services_list " in *" xdm "*) ;; *) failures="$failures xdm-not-enabled" ;; esac
            ;;
        sddm)
            [ -x "$TARGET/etc/rc.d/sddm" ] || failures="$failures sddm-service"
            case " $services_list " in *" sddm "*) ;; *) failures="$failures sddm-not-enabled" ;; esac
            ;;
    esac
    if [ "$install_flatpak" = yes ]; then
        [ -x "$TARGET/usr/bin/flatpak" ] || failures="$failures flatpak"
        chroot "$TARGET" /usr/bin/flatpak remotes --columns=name 2>/dev/null | grep -Fxq flathub || failures="$failures flathub-remote"
    fi
    if [ "$selected_gpu" = nvidia ]; then
        find "$TARGET/lib/modules/$kernel_version" -type f -name 'nvidia*.ko*' 2>/dev/null | grep -q . || failures="$failures nvidia-kernel-modules"
        [ -x "$TARGET/usr/bin/nvidia-smi" ] || failures="$failures nvidia-smi"
    fi
    case "$selected_gpu" in
        amd|intel)
            find "$TARGET/usr/lib" -type f \( -name 'libGL.so*' -o -name 'libEGL.so*' \) 2>/dev/null | grep -q . || failures="$failures mesa-runtime"
            ;;
    esac
    if [ -n "$failures" ]; then
        die "final validation failed; missing or invalid:$failures"
    fi
    chroot "$TARGET" /sbin/ldconfig 2>/dev/null || true
    info "final validation passed"
} 

write_postinstall_notes() {
    notes="$TARGET/root/POSTINSTALL.txt"
    rejected_count=$(find "$TARGET/var/lib/pkg/rejected" -type f 2>/dev/null | wc -l | awk '{print $1}')
    cp "$LOGFILE" "$TARGET/root/crux-installer.log" 2>/dev/null || true
    cat > "$notes" <<EOF
CRUX $CRUX_RELEASE post-install checklist
Generated by CRUX Enhanced Installer $VERSION

System
  Hostname:          $hostn
  Timezone:          $tzone
  Root filesystem:   $root_fs
  Root partition:    $rdiskr
  User account:      $user_name
EOF
    if [ -n "$desktop_label" ]; then
        cat >> "$notes" <<EOF
  Desktop:           $desktop_label
  Display manager:   $display_manager
  NetworkManager:    $use_networkmanager
  PipeWire:          $install_pipewire
  Flatpak:           $install_flatpak
EOF
    fi
    cat >> "$notes" <<EOF

Before relying on the system
  1. Review /etc/fstab, /etc/rc.conf, and /etc/rc.d/net.
  2. Check /var/lib/pkg/rejected and run rejmerge when needed.
  3. Confirm that storage, root-filesystem, input, GPU, and network drivers are
     built into the kernel or otherwise available before the root filesystem
     is mounted. This installer forces the selected root filesystem itself to
     be built in, but it cannot safely guess every storage controller.
  4. After port updates, run revdep if opt/prt-utils is installed.
  5. Keep unofficial repository Pkgfiles under review. prt-get searches
     repositories in the order listed in /etc/prt-get.conf.

Rejected configuration files currently found: ${rejected_count:-0}
Installer log copied to: /root/crux-installer.log
EOF

    if [ "$install_pipewire" = yes ]; then
        cat >> "$notes" <<EOF

PipeWire
  PipeWire, pipewire-pulse, and WirePlumber are started by one KDE autostart launcher at ~/.local/bin/crux-start-pipewire. Use alsamixer and 'alsactl store' to configure ALSA.
EOF
    fi
    chmod 0600 "$notes"
}

show_summary() {
    say ""
    say "Installation summary"
    say "--------------------"
    say "Target disk:       $rdisk"
    say "Root partition:    $rdiskr ($root_fs)"
    [ -n "$boot" ] && say "EFI partition:     $boot"
    [ -n "$sw" ] && say "Swap partition:    $sw"
    [ -n "$home" ] && say "Home partition:    $home ($home_fs)"
    say "Hostname:          $hostn"
    say "Timezone:          $tzone"
    say "User:              $user_name"
    [ -n "$desktop_label" ] && say "Desktop:           $desktop_label"
    [ "$desktop_choice" != none ] && say "Graphics:          $selected_gpu"
    [ "$desktop_choice" != none ] && say "Display manager:   $display_manager"
    say "Services:          $services_list"
    say "Post-install file: /root/POSTINSTALL.txt"
}

rejected_files_warning() {
    count=$(find "$TARGET/var/lib/pkg/rejected" -type f 2>/dev/null | wc -l | awk '{print $1}')
    case "$count" in ''|0) return 0 ;; esac
    warn "$count rejected configuration file(s) are waiting under /var/lib/pkg/rejected"
    warn "review them with rejmerge before rebooting into an upgraded system"
}

mount_source_for() {
    point=$1
    if have findmnt; then
        findmnt -n -o SOURCE --target "$point" 2>/dev/null | head -n 1
    else
        awk -v p="$point" '$2 == p {print $1; exit}' /proc/mounts 2>/dev/null
    fi
}

resume_mount_existing_system() {
    say ""
    say "Resume target selection"
    say "-----------------------"
    say "This mode does not format or repartition anything."

    select_disk

    if is_mounted "$TARGET"; then
        mounted_root=$(mount_source_for "$TARGET")
        say "Detected $TARGET already mounted from ${mounted_root:-an unknown device}."
        case "$mounted_root" in
            /dev/*)
                rdiskr=$mounted_root
                ;;
            *)
                die "cannot safely identify the block device mounted at $TARGET"
                ;;
        esac
        validate_block_or_die "mounted root partition" "$rdiskr"
        case " $(partition_candidates) " in
            *" $rdiskr "*) ;;
            *) die "$rdiskr is not a partition on selected disk $rdisk" ;;
        esac
    else
        while :; do
            select_existing_partition "Existing CRUX root" no || continue
            rdiskr=$SELECTED_BLOCK
            break
        done
        root_fs=$(blk_value TYPE "$rdiskr")
        [ -n "$root_fs" ] || die "could not detect a filesystem on $rdiskr"
        mount_root_target
    fi

    root_fs=$(blk_value TYPE "$rdiskr")
    [ -n "$root_fs" ] || root_fs=$(awk -v p="$TARGET" '$2 == p {print $3; exit}' /proc/mounts 2>/dev/null)
    [ -n "$root_fs" ] || die "could not determine the root filesystem type"

    [ -x "$TARGET/bin/sh" ] || die "$rdiskr does not look like an installed CRUX root"

    boot=""
    if is_uefi; then
        if is_mounted "$TARGET/boot"; then
            boot=$(mount_source_for "$TARGET/boot")
            case "$boot" in /dev/*) ;; *) boot="" ;; esac
            [ -n "$boot" ] && info "reusing EFI partition $boot mounted at $TARGET/boot"
        fi
        if [ -z "$boot" ]; then
            suggested_esp=$(find_esp_candidate || true)
            [ -n "$suggested_esp" ] && say "Detected likely EFI System Partition: $suggested_esp"
            while :; do
                select_existing_partition "EFI System" no || continue
                boot=$SELECTED_BLOCK
                [ "$boot" != "$rdiskr" ] || { warn "root and EFI partitions cannot be the same"; continue; }
                [ "$(blk_value TYPE "$boot")" = vfat ] || { warn "$boot is not FAT32/vfat"; continue; }
                break
            done
            mkdir -p "$TARGET/boot"
            mount "$boot" "$TARGET/boot" || die "failed to mount EFI partition $boot"
        fi
    fi

    sw=""
    home=""
    home_fs=""
    if is_mounted "$TARGET/home"; then
        home=$(mount_source_for "$TARGET/home")
        case "$home" in /dev/*) home_fs=$(blk_value TYPE "$home") ;; *) home="" ;; esac
    fi
}

default_existing_user() {
    awk -F: '$3 >= 1000 && $3 < 65534 && $1 != "nobody" {print $1; exit}' "$TARGET/etc/passwd" 2>/dev/null
}

select_resume_user() {
    detected_user=$(default_existing_user)
    [ -n "$detected_user" ] || detected_user=user
    while :; do
        user_name=$(ask "Existing desktop user" "$detected_user")
        valid_username "$user_name" || { warn "invalid user name"; continue; }
        if grep -q "^${user_name}:" "$TARGET/etc/passwd" 2>/dev/null; then
            return 0
        fi
        warn "user '$user_name' does not exist in the target system"
        if confirm "Create accounts and set passwords now?" "y"; then
            configure_passwords_and_user
            return 0
        fi
    done
}

resume_install() {
    install_mode=resume
    say ""
    say "Interrupted-install recovery"
    say "----------------------------"
    say "Use this after the base system and user account were created but a later"
    say "desktop, repository, kernel, or bootloader step failed. Nothing is formatted."

    configure_identity
    configure_install_network
    resume_mount_existing_system
    verify_base_install
    mount_bindings
    copy_resolver_configuration
    select_resume_user
    collect_optional_choices
    configure_repositories
    configure_privilege_escalation
    update_installed_ports
    verify_selected_port_plan
    prepare_graphics_stack
    prepare_flatpak_stack
    configure_desktop
    configure_flatpak
    write_system_configuration
    build_kernel
    install_gpu_drivers
    write_system_configuration
    install_bootloader
    validate_installation
    rejected_files_warning
    write_postinstall_notes
    show_summary
    finish_menu
}

upgrade_install() {
    install_mode=upgrade
    say ""
    say "Existing-system upgrade"
    say "-----------------------"
    say "This path mounts an installed system and launches the official CRUX 3.8"
    say "setup upgrade flow. It does not repartition or format anything."
    select_disk

    default_root=$(partdev 3)
    [ -b "$default_root" ] || default_root=$(partdev 2)
    rdiskr=$(ask "Existing root partition" "$default_root")
    validate_block_or_die "root partition" "$rdiskr"
    root_fs=$(blk_value TYPE "$rdiskr")
    [ -n "$root_fs" ] || die "could not detect the root filesystem"
    mount_root_target

    boot=""
    if is_uefi; then
        default_boot=$(partdev 1)
        boot=$(ask_optional "EFI System Partition" "$default_boot")
        if [ -n "$boot" ]; then
            validate_block_or_die "EFI System Partition" "$boot"
            mkdir -p "$TARGET/boot"
            mount "$boot" "$TARGET/boot" || die "failed to mount EFI System Partition"
        fi
    fi

    /usr/bin/setup || die "official CRUX upgrade setup failed"
    mount_bindings
    copy_resolver_configuration
    rejected_files_warning

    if confirm "Synchronize CRUX 3.8 ports and run prt-get sysup?" "y"; then
        configure_pkgmk_cache
        configure_prt_get
        ensure_official_repositories
        sync_ports_trees
        update_ports_now=yes
        update_installed_ports
        rejected_files_warning
    fi
    if confirm "Build and install a kernel from the CRUX 3.8 ISO?" "n"; then
        build_kernel
    fi
    if confirm "Reinstall GRUB?" "y"; then
        install_bootloader
    fi

    write_upgrade_notes
    finish_menu
}

write_upgrade_notes() {
    notes="$TARGET/root/UPGRADE-NOTES.txt"
    cp "$LOGFILE" "$TARGET/root/crux-installer.log" 2>/dev/null || true
    cat > "$notes" <<EOF
CRUX $CRUX_RELEASE upgrade notes
Generated by CRUX Enhanced Installer $VERSION

Review /var/lib/pkg/rejected with rejmerge before rebooting.
Run revdep after the package update if opt/prt-utils is installed.
Review the CRUX 3.8 release notes for renamed packages and ABI changes.
Verify /etc/fstab, /etc/rc.conf, the kernel, and GRUB configuration.
EOF
    chmod 0600 "$notes"
}

fresh_install() {
    install_mode=fresh
    configure_identity
    configure_install_network
    select_disk
    partition_menu
    setup_base_packages
    mount_bindings
    copy_resolver_configuration
    configure_passwords_and_user
    collect_optional_choices
    configure_repositories
    configure_privilege_escalation
    update_installed_ports
    verify_selected_port_plan
    prepare_graphics_stack
    prepare_flatpak_stack
    configure_desktop
    configure_flatpak
    write_system_configuration
    build_kernel
    install_gpu_drivers
    # GPU packages may add boot parameters, modules, and services.
    write_system_configuration
    install_bootloader
    validate_installation
    rejected_files_warning
    write_postinstall_notes
    show_summary
    finish_menu
}

unmount_if_mounted() {
    point=$1
    is_mounted "$point" && umount "$point" >/dev/null 2>&1 || true
}

cleanup_bindings() {
    [ "$bindings_mounted" = yes ] || return 0
    unmount_if_mounted "$TARGET/sys/firmware/efi/efivars"
    unmount_if_mounted "$TARGET/dev/pts"
    unmount_if_mounted "$TARGET/proc"
    unmount_if_mounted "$TARGET/sys"
    unmount_if_mounted "$TARGET/run"
    unmount_if_mounted "$TARGET/dev"
    bindings_mounted=no
}

cleanup_target_mounts() {
    cleanup_bindings
    unmount_if_mounted "$TARGET/boot"
    unmount_if_mounted "$TARGET/home"
    unmount_if_mounted "$TARGET"
    [ -n "$sw" ] && swapoff "$sw" >/dev/null 2>&1 || true
}

on_interrupt() {
    warn "installation interrupted"
    if [ "$keep_mounts" != yes ]; then
        cleanup_bindings
    fi
    exit 130
}

finish_menu() {
    say ""
    say "The requested installation work is complete. Review warnings before rebooting."
    say "Log: $LOGFILE"
    say ""
    say "  1) Reboot"
    say "  2) Power off"
    say "  3) Exit to shell and keep the target mounted"
    say "  4) Unmount everything and exit to shell"
    action=$(choose_number "Choose the next action" "1" 1 4)
    case "$action" in
        1)
            cleanup_target_mounts
            sync
            /sbin/reboot
            ;;
        2)
            cleanup_target_mounts
            sync
            /sbin/shutdown -Ph now
            ;;
        3)
            keep_mounts=yes
            say "Target system remains mounted at $TARGET."
            exit 0
            ;;
        4)
            cleanup_target_mounts
            say "Target mounts were cleaned up."
            exit 0
            ;;
    esac
}

self_test() {
    failures=0
    valid_hostname crux || failures=$((failures + 1))
    valid_hostname bad_name && failures=$((failures + 1))
    valid_username robert || failures=$((failures + 1))
    valid_username root && failures=$((failures + 1))
    valid_ipv4 192.168.1.1 || failures=$((failures + 1))
    valid_ipv4 999.1.1.1 && failures=$((failures + 1))
    rdisk=/dev/nvme0n1
    [ "$(partdev 3)" = /dev/nvme0n1p3 ] || failures=$((failures + 1))
    rdisk=/dev/sda
    [ "$(partdev 3)" = /dev/sda3 ] || failures=$((failures + 1))
    FS_RESULT=ext4
    case "$FS_RESULT" in ext4|btrfs|xfs|jfs|ext3|ext2) ;; *) failures=$((failures + 1)) ;; esac
    command -v ports >/dev/null 2>&1 || true
    if [ "$failures" -ne 0 ]; then
        printf 'self-test: FAIL (%s checks failed)\n' "$failures" >&2
        return 1
    fi
    printf 'self-test: PASS\n'
}

main() {
    trap on_interrupt INT TERM HUP
    case "${1:-}" in
        --version)
            printf 'CRUX Easy Installer %s (CRUX %s)\n' "$VERSION" "$CRUX_RELEASE"
            exit 0
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        --self-test)
            self_test
            exit $?
            ;;
        --shell)
            exit 0
            ;;
        --install|--resume|--upgrade|'') ;;
        *)
            show_help >&2
            exit 2
            ;;
    esac

    preflight
    show_banner
    case "${1:-}" in
        --install) fresh_install ;;
        --resume) resume_install ;;
        --upgrade) upgrade_install ;;
        '') main_menu ;;
    esac
}

main "$@"
